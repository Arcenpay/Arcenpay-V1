# ============================================================
#  ArcenPay Protocol — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# --- Launch Profile ---
# Base Sepolia-first defaults for the dashboard + facilitator.
NEXT_PUBLIC_CHAIN_ID=5042002
ARCENPAY_DEFAULT_CHAIN_ID=5042002
CHAIN_ID=5042002
ARCENPAY_ENABLE_SELF_SERVE_PLAN_CHANGES=false
ARCENPAY_ENABLE_SELF_SERVE_CANCELLATION=false
ARCENPAY_REQUIRE_SUBGRAPH=false
# Keep false until mainnet contracts, RPC, facilitator, tokens, and treasury
# configuration have been reviewed and approved.
ARCENPAY_ENABLE_PRODUCTION_ENVIRONMENTS=false
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_PLAN_CHANGES=false
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_CANCELLATION=false
NEXT_PUBLIC_ARCENPAY_REQUIRE_SUBGRAPH=false

# --- Deployer / Signers ---
DEPLOYER_PRIVATE_KEY=replace_with_private_key
PRIVATE_KEY=
ONCHAIN_PROVIDER_PRIVATE_KEY=
SUBSCRIPTION_BILLER_PRIVATE_KEY=
PLAN_FACTORY_OWNER_PRIVATE_KEY=

# --- RPC URLs ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# ARC_USDC_ADDRESS=  # Set this after deploying MockUSDC on Arc Testnet
RPC_URL_84532=https://sepolia.base.org
RPC_URL=${RPC_URL_84532}

# --- Block Explorer API Keys ---
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- External Service Keys (Phase 2+) ---
ARCJET_KEY=ajkey_your_arcjet_key_here
# ARCJET_ENV=development  # Set to "development" for local dev (default: production)
LIT_PROTOCOL_API_KEY=
# ZERODEV_PROJECT_ID=
# TABLELAND_PROVIDER_URL=
# AXELAR_API_KEY=

# --- Backend API ---
BACKEND_URL=http://localhost:3300
BACKEND_PORT=3300
NEXT_PUBLIC_BACKEND_URL=http://localhost:3300

# --- Dashboard / App ---
DATABASE_URL=postgresql://arcenpay:arcenpay_dev@localhost:5433/arcenpay
POSTGRES_PORT=5433
SIWE_JWT_SECRET=replace_with_strong_secret
ACCESS_TOKEN_SECRET=replace_with_strong_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPH_URL=
NEXT_PUBLIC_GRAPH_URL_84532=
ARCENPAY_SUBGRAPH_URL_11155111=
ARCENPAY_SUBGRAPH_URL_84532=
ARCENPAY_SUBGRAPH_URL_8453=
ARCENPAY_SUBGRAPH_URL_5042002=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
RESEND_API_KEY=
EMAIL_FROM=noreply@arcenpay.xyz
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# ── Object storage (Cloudflare R2, S3-compatible) ─────────────────────────────
# STORAGE_DRIVER=r2 enables R2. Leave unset (or "local") for the dev
# filesystem fallback under INVOICE_STORAGE_DIR.
STORAGE_DRIVER=local
# Account ID from the Cloudflare dashboard: https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Facilitator ---
FACILITATOR_URL=http://localhost:3402
FACILITATOR_BASE_URL_84532=http://localhost:3402
ARCENPAY_FACILITATOR_URL_11155111=
ARCENPAY_FACILITATOR_URL_84532=
ARCENPAY_FACILITATOR_URL_8453=
ARCENPAY_FACILITATOR_URL_5042002=
FACILITATOR_SECRET=replace_with_shared_secret
DASHBOARD_URL=http://localhost:3000
DASHBOARD_TEAM_ID=
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
# Tableland — decentralized on-chain feature flag entitlement storage.
# Step 1: Run `npm run tableland:create` to create the table on Base Sepolia.
#         Table name format: arcenpay_entitlements_84532_<id>
#         This will print the exact table name — paste it below.
# Step 2: Use the same private key as DEPLOYER_PRIVATE_KEY (or a dedicated one).
#         Get free Sepolia ETH at: https://sepoliafaucet.com or https://faucets.chain.link/sepolia
# If unset, flags fall back to PostgreSQL only (no on-chain mirror).
TABLELAND_TABLE_NAME=
TABLELAND_PRIVATE_KEY=
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380
RPC_URL_11155111=
RPC_URL_8453=
RPC_URL_5042002=
ARCENPAY_RPC_URL_11155111=
ARCENPAY_RPC_URL_84532=
ARCENPAY_RPC_URL_8453=
ARCENPAY_PROOF_ARTIFACT_VERSION=
ARCENPAY_PROOF_ARTIFACT_MANIFEST_PATH=

# --- Contract Addresses (auto-populated by deploy script) ---
# Point the launch environment at your Base Sepolia deployment.
ARCENPAY_CONTRACT_84532_planFactory=
ARCENPAY_CONTRACT_84532_subscriptionRegistry=
ARCENPAY_CONTRACT_84532_autopayModule=
ARCENPAY_CONTRACT_84532_feeCollector=
ARCENPAY_CONTRACT_84532_sessionVault=
ARCENPAY_CONTRACT_84532_zkUsageVerifier=
ARCENPAY_CONTRACT_84532_mirrorRegistry=
# Uncomment after Arc Testnet deployment:
# ARCENPAY_CONTRACT_5042002_planFactory=
# ARCENPAY_CONTRACT_5042002_subscriptionRegistry=
# ARCENPAY_CONTRACT_5042002_autopayModule=
# ARCENPAY_CONTRACT_5042002_feeCollector=
# ARCENPAY_CONTRACT_5042002_sessionVault=
# ARCENPAY_CONTRACT_5042002_zkUsageVerifier=
# ARCENPAY_CONTRACT_5042002_mirrorRegistry=

# --- Solana (Devnet deployed; Mainnet pending) ---
# Synthetic chainIds: 9100000 (mainnet), 9100001 (devnet), 9100002 (testnet).
# Run one facilitator process per chain: CHAIN_ID=9100001.
# Server-side RPC override (facilitator/backend). The dashboard falls back to
# the public devnet RPC baked into the chain registry.
#
# RPC endpoints are per chain and support a FAILOVER LIST: put several
# comma-separated URLs and a request that gets 429/5xx (or a network error) is
# retried against the next one. So you can run on free endpoints today and swap
# in a paid provider later purely by env — no code change.
#   e.g. ARCENPAY_SOLANA_RPC_URL_9100001=https://mainnet.helius-rpc.com/?api-key=K,https://api.devnet.solana.com
# A free Helius/QuickNode tier is still free and removes the public-endpoint 429s.
ARCENPAY_SOLANA_RPC_URL_9100001=https://api.devnet.solana.com
# ARCENPAY_SOLANA_RPC_URL_9100000=https://api.mainnet-beta.solana.com
# EVM chains use the same pattern: ARCENPAY_RPC_URL_<chainId>=url1,url2
# ARCENPAY_RPC_URL_5042002=
# ARCENPAY_RPC_URL_84532=
# Autopay relayer (opt-in). The relayer pays network fees ONLY — it holds no
# subscriber key and has no spending authority; the on-chain (owner, mint)
# delegate PDA is the SPL spender. Value is a base58 or JSON 64-byte keypair
# secret (generate one with `solana-keygen new -o relayer.json`). The public
# key needs a little SOL for fees.
SOLANA_RENEWAL_DRIVER_ENABLED=false
SOLANA_RELAYER_PRIVATE_KEY=
SOLANA_RENEWAL_BATCH_SIZE=25
# How long the backend waits for a wallet-confirmed Solana transaction to appear
# on its own RPC node before returning 425 (ms). Default 15000 — keep it below
# the SDK request timeout (30s).
SOLANA_TX_WAIT_MS=15000
# Settlement signer keys are PER CHAIN, because the key FORMAT is family-specific
# (EVM = 0x hex; Solana = base58/JSON keypair; Stellar = S…). Resolution order
# for a facilitator running CHAIN_ID=<id>:
#   SETTLEMENT_PRIVATE_KEY_<id>  ->  SETTLEMENT_PRIVATE_KEY  ->  PRIVATE_KEY
# A single shared key cannot serve several chains in one container.
#   SETTLEMENT_PRIVATE_KEY_9100001=   # Solana keypair; register with authorize_settler
#   SETTLEMENT_PRIVATE_KEY_5042002=0x…# EVM 32-byte hex
#   SETTLEMENT_PRIVATE_KEY_9000001=   # Stellar S… secret
# Program ids — fill in after `anchor deploy` in packages/solana-programs.
# ARCENPAY_CONTRACT_9100001_subscriptionRegistry=
# ARCENPAY_CONTRACT_9100001_autopayModule=
# ARCENPAY_CONTRACT_9100001_planFactory=
# ARCENPAY_CONTRACT_9100001_feeCollector=
# ARCENPAY_CONTRACT_9100001_sessionVault=
# ARCENPAY_CONTRACT_9100001_zkUsageVerifier=
# ARCENPAY_CONTRACT_9100001_mirrorRegistry=

# --- Platform Administration & Activation ---
PLATFORM_ADMIN_EMAILS=admin@arcenpay.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=admin@arcenpay.com
PLATFORM_REQUIRE_ACTIVATION_KEY=false

# ── Dune Analytics ──────────────────────────────────────────────────────
DUNE_API_KEY=dune_xxx_placeholder

# ── Google Analytics (GA4) ────────────────────────────────────────────────
# Public measurement ID — baked into the client bundle at build time.
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=G-4J0FQMCLNR
