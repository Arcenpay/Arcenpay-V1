# ============================================================
#  Arcenpay / MEAP Protocol — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# --- Deployer / Signer ---
DEPLOYER_PRIVATE_KEY=your_private_key_here

# --- RPC URLs ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# --- Block Explorer API Keys ---
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- External Service Keys (Phase 2+) ---
LIT_PROTOCOL_API_KEY=
# ZERODEV_PROJECT_ID=
# TABLELAND_PROVIDER_URL=
# AXELAR_API_KEY=

# --- Dashboard / App ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arcenpay
SIWE_JWT_SECRET=replace_with_strong_secret
NEXT_PUBLIC_GRAPH_URL=https://api.studio.thegraph.com/query/<org>/<subgraph>/version/latest
MEAP_SUBGRAPH_URL_11155111=
MEAP_SUBGRAPH_URL_84532=
MEAP_SUBGRAPH_URL_8453=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
RESEND_API_KEY=
EMAIL_FROM=noreply@arcenpay.xyz
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# --- Facilitator ---
FACILITATOR_URL=http://localhost:3402
MEAP_FACILITATOR_URL_11155111=
MEAP_FACILITATOR_URL_84532=
MEAP_FACILITATOR_URL_8453=
FACILITATOR_SECRET=replace_with_shared_secret
DASHBOARD_URL=http://localhost:3000
DASHBOARD_TEAM_ID=
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
# Tableland — decentralized on-chain feature flag entitlement storage.
# Step 1: Run `npm run tableland:create` to create the table on Ethereum Sepolia.
#         Table name format: arcenpay_entitlements_11155111_<id>
#         This will print the exact table name — paste it below.
# Step 2: Use the same private key as DEPLOYER_PRIVATE_KEY (or a dedicated one).
#         Get free Sepolia ETH at: https://sepoliafaucet.com or https://faucets.chain.link/sepolia
# If unset, flags fall back to PostgreSQL only (no on-chain mirror).
TABLELAND_TABLE_NAME=
TABLELAND_PRIVATE_KEY=
REDIS_URL=
MEAP_RPC_URL_11155111=
MEAP_RPC_URL_84532=
MEAP_RPC_URL_8453=
MEAP_PROOF_ARTIFACT_VERSION=
MEAP_PROOF_ARTIFACT_MANIFEST_PATH=

# --- Contract Addresses (auto-populated by deploy script) ---
# See packages/contracts/deployments/sepolia-latest.json
