# ============================================================
#  Arcenpay / MEAP Protocol — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# --- Launch Profile ---
# Base Sepolia-first defaults for the dashboard + facilitator.
NEXT_PUBLIC_CHAIN_ID=84532
MEAP_DEFAULT_CHAIN_ID=84532
CHAIN_ID=84532
ARCENPAY_ENABLE_SELF_SERVE_PLAN_CHANGES=false
ARCENPAY_ENABLE_SELF_SERVE_CANCELLATION=false
ARCENPAY_REQUIRE_SUBGRAPH=false
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_PLAN_CHANGES=false
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_CANCELLATION=false
NEXT_PUBLIC_ARCENPAY_REQUIRE_SUBGRAPH=false

# --- Deployer / Signers ---
DEPLOYER_PRIVATE_KEY=replace_with_private_key
PRIVATE_KEY=
ONCHAIN_PROVIDER_PRIVATE_KEY=
SUBSCRIPTION_BILLER_PRIVATE_KEY=
PLAN_FACTORY_OWNER_PRIVATE_KEY=

# --- RPC URLs ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# ARC_USDC_ADDRESS=  # Set this after deploying MockUSDC on Arc Testnet
RPC_URL_84532=https://sepolia.base.org
RPC_URL=${RPC_URL_84532}

# --- Block Explorer API Keys ---
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- External Service Keys (Phase 2+) ---
ARCJET_KEY=ajkey_your_arcjet_key_here
# ARCJET_ENV=development  # Set to "development" for local dev (default: production)
LIT_PROTOCOL_API_KEY=
# ZERODEV_PROJECT_ID=
# TABLELAND_PROVIDER_URL=
# AXELAR_API_KEY=

# --- Backend API ---
BACKEND_URL=http://localhost:3300
BACKEND_PORT=3300
NEXT_PUBLIC_BACKEND_URL=http://localhost:3300

# --- Dashboard / App ---
DATABASE_URL=postgresql://arcenpay:arcenpay_dev@localhost:5432/arcenpay
POSTGRES_PORT=5432
SIWE_JWT_SECRET=replace_with_strong_secret
ACCESS_TOKEN_SECRET=replace_with_strong_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPH_URL=
NEXT_PUBLIC_GRAPH_URL_84532=
MEAP_SUBGRAPH_URL_11155111=
MEAP_SUBGRAPH_URL_84532=
MEAP_SUBGRAPH_URL_8453=
MEAP_SUBGRAPH_URL_5042002=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
RESEND_API_KEY=
EMAIL_FROM=noreply@arcenpay.xyz
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# --- Facilitator ---
FACILITATOR_URL=http://localhost:3402
FACILITATOR_BASE_URL_84532=http://localhost:3402
MEAP_FACILITATOR_URL_11155111=
MEAP_FACILITATOR_URL_84532=
MEAP_FACILITATOR_URL_8453=
MEAP_FACILITATOR_URL_5042002=
FACILITATOR_SECRET=replace_with_shared_secret
DASHBOARD_URL=http://localhost:3000
DASHBOARD_TEAM_ID=
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
# Tableland — decentralized on-chain feature flag entitlement storage.
# Step 1: Run `npm run tableland:create` to create the table on Base Sepolia.
#         Table name format: arcenpay_entitlements_84532_<id>
#         This will print the exact table name — paste it below.
# Step 2: Use the same private key as DEPLOYER_PRIVATE_KEY (or a dedicated one).
#         Get free Sepolia ETH at: https://sepoliafaucet.com or https://faucets.chain.link/sepolia
# If unset, flags fall back to PostgreSQL only (no on-chain mirror).
TABLELAND_TABLE_NAME=
TABLELAND_PRIVATE_KEY=
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
RPC_URL_11155111=
RPC_URL_8453=
RPC_URL_5042002=
MEAP_RPC_URL_11155111=
MEAP_RPC_URL_84532=
MEAP_RPC_URL_8453=
MEAP_PROOF_ARTIFACT_VERSION=
MEAP_PROOF_ARTIFACT_MANIFEST_PATH=

# --- Contract Addresses (auto-populated by deploy script) ---
# Point the launch environment at your Base Sepolia deployment.
ARCENPAY_CONTRACT_84532_planFactory=
ARCENPAY_CONTRACT_84532_subscriptionRegistry=
ARCENPAY_CONTRACT_84532_autopayModule=
ARCENPAY_CONTRACT_84532_feeCollector=
ARCENPAY_CONTRACT_84532_sessionVault=
ARCENPAY_CONTRACT_84532_zkUsageVerifier=
ARCENPAY_CONTRACT_84532_mirrorRegistry=
# Uncomment after Arc Testnet deployment:
# ARCENPAY_CONTRACT_5042002_planFactory=
# ARCENPAY_CONTRACT_5042002_subscriptionRegistry=
# ARCENPAY_CONTRACT_5042002_autopayModule=
# ARCENPAY_CONTRACT_5042002_feeCollector=
# ARCENPAY_CONTRACT_5042002_sessionVault=
# ARCENPAY_CONTRACT_5042002_zkUsageVerifier=
# ARCENPAY_CONTRACT_5042002_mirrorRegistry=
