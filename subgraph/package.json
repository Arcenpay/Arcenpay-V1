{
  "name": "@arcenpay/subgraph",
  "version": "1.0.0",
  "private": true,
  "description": "The Graph indexer for ArcenPay + ZKVUB",
  "scripts": {
    "prepare:abis": "node scripts/sync-abis.mjs",
    "sync:sepolia": "node scripts/sync-addresses.mjs --deployment ../packages/contracts/deployments/sepolia-latest.json --network sepolia",
    "sync:base-sepolia": "node scripts/sync-addresses.mjs --deployment ../packages/contracts/deployments/base-sepolia-latest.json --network base-sepolia --config subgraph.base-sepolia.yaml",
    "codegen": "graph codegen",
    "codegen:base-sepolia": "graph codegen --config subgraph.base-sepolia.yaml",
    "build": "graph codegen && graph build",
    "build:base-sepolia": "graph codegen --config subgraph.base-sepolia.yaml && graph build --config subgraph.base-sepolia.yaml",
    "lint": "echo \"No subgraph lint configured\"",
    "test": "echo \"No subgraph tests implemented yet\"",
    "deploy:studio": "graph deploy arcenpay-sepolia --node https://api.studio.thegraph.com/deploy/ -l \"$(date +%Y%m%d%H%M%S)\"",
    "deploy:studio:subscription-registry": "graph deploy subscription-registry --node https://api.studio.thegraph.com/deploy/ -l \"$(date +%Y%m%d%H%M%S)\"",
    "deploy:studio:base-sepolia": "graph deploy arcenpay-base-sepolia subgraph.base-sepolia.yaml --node https://api.studio.thegraph.com/deploy/ -l \"$(date +%Y%m%d%H%M%S)\"",
    "deploy:hosted": "graph deploy --node https://api.thegraph.com/deploy/ @arcenpay/arcenpay-sepolia",
    "deploy:hosted:base-sepolia": "graph deploy --node https://api.thegraph.com/deploy/ @arcenpay/arcenpay-base-sepolia --config subgraph.base-sepolia.yaml"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "assemblyscript": "^0.27.37"
  }
}
