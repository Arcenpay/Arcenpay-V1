# ── Profile / Server ────────────────────────────────────────────────────────────
FACILITATOR_PROFILE=development
PORT=3402
NODE_ENV=development

# ── Chain / RPC (testnet defaults) ─────────────────────────────────────────────
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# ── Operator Keys ───────────────────────────────────────────────────────────────
# Used for settlement, keeper, and signing
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Optional dedicated key for proof submission (falls back to PRIVATE_KEY)
# PROOF_SIGNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Proof Runtime ───────────────────────────────────────────────────────────────
PROOF_MODE=dev
# Optional explicit artifact paths
# ZK_CIRCUIT_WASM_PATH=/absolute/path/UsageBilling.wasm
# ZK_CIRCUIT_ZKEY_PATH=/absolute/path/circuit_final.zkey
# ZK_CIRCUIT_VKEY_PATH=/absolute/path/verification_key.json

# ── x402 Settlement ─────────────────────────────────────────────────────────────
X402_ENABLE_SETTLEMENT=true
X402_REQUIRE_SETTLER_AUTH=true

# ── Contract Addresses (Sepolia defaults) ──────────────────────────────────────
SESSION_VAULT_ADDRESS=0x2dccEaad8551a620E4Fc736bb4d0fbb8D1A17D7C
ZK_USAGE_VERIFIER_ADDRESS=0x265E0dC80b00044d183AFa83237F5976bB4d585c
PLAN_FACTORY_ADDRESS=0xc736f5d91aC0039b97A4Fc3540B8f3d59E7FdBa6
SUBSCRIPTION_REGISTRY_ADDRESS=0xf45A9E5280F72260a713c50b0Ca4e4FB1e22Cc8A
FEE_COLLECTOR_ADDRESS=0x513fab5218045790364b33A38D95FE8E17403BAe

# ── Redis / Queue ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Email Notifications (optional) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=billing@arcenpay.xyz
BRAND_NAME=ArcenPay

# ── Dashboard Integration ───────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
# Optional team id for dashboard sync routes
# DASHBOARD_TEAM_ID=team_xxx
# Must match apps/arcen-dashboard FACILITATOR_SECRET
FACILITATOR_SECRET=your_shared_secret_here

# ── ERC-4337 Paymaster (testnet) ───────────────────────────────────────────────
# Preferred env for sponsorship RPC:
PAYMASTER_RPC_URL=https://rpc.zerodev.app/api/v2/paymaster/YOUR_PROJECT_ID
# Optional legacy alias still supported by server:
# ZERODEV_PAYMASTER_RPC=https://rpc.zerodev.app/api/v2/paymaster/YOUR_PROJECT_ID
PAYMASTER_CHAIN_IDS=84532
PAYMASTER_ENTRYPOINT=0x0000000071727de22e5e9d8baf0edac6f37da032
PAYMASTER_RPC_METHOD=pm_sponsorUserOperation
# PAYMASTER_RPC_AUTH_TOKEN=
PAYMASTER_ESTIMATED_GAS_USED=120000
PAYMASTER_ESTIMATED_GAS_COST_USD=0.05

# ── Webhooks (optional) ─────────────────────────────────────────────────────────
# WEBHOOK_URL=https://your-webhook-endpoint.example
WEBHOOK_SIGNING_SECRET=whsec_change_me

# ── Tableland (optional) ────────────────────────────────────────────────────────
# TABLELAND_TABLE_NAME=arcenpay_flags_11155111_1
TABLELAND_PRIVATE_KEY=0xYOUR_TABLELAND_KEY
TABLELAND_CHAIN=ethereum-sepolia
# TABLELAND_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# TABLELAND_GATEWAY_URL=https://testnets.tableland.network

# ── Lit Protocol (optional) ─────────────────────────────────────────────────────
LIT_NETWORK=datil-dev

# ── Cross-chain Transport (optional) ───────────────────────────────────────────
# Axelar
# AXELAR_GATEWAY_ADDRESS=0x...
# AXELAR_GAS_SERVICE_ADDRESS=0x...
# CCIP
# CCIP_ROUTER_ADDRESS=0x...
# CCIP_LINK_TOKEN_ADDRESS=0x...
