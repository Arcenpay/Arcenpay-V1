# ── Profile / Server ────────────────────────────────────────────────────────────
FACILITATOR_PROFILE=development
PORT=3402
NODE_ENV=development

# ── Chain / RPC (testnet defaults) ─────────────────────────────────────────────
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# ── Operator Keys ───────────────────────────────────────────────────────────────
# Used for settlement, keeper, and signing
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Optional dedicated key for proof submission (falls back to PRIVATE_KEY)
# PROOF_SIGNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Proof Runtime ───────────────────────────────────────────────────────────────
PROOF_MODE=dev
# Optional explicit artifact paths
# ZK_CIRCUIT_WASM_PATH=/absolute/path/UsageBilling.wasm
# ZK_CIRCUIT_ZKEY_PATH=/absolute/path/circuit_final.zkey
# ZK_CIRCUIT_VKEY_PATH=/absolute/path/verification_key.json

# ── x402 Settlement ─────────────────────────────────────────────────────────────
X402_ENABLE_SETTLEMENT=true
X402_REQUIRE_SETTLER_AUTH=true

# ── Contract Addresses (Arc Testnet) ─────────────────────────────────────────
# Set via ARCENPAY_CONTRACT_<chainId>_<contract> env vars (read from @arcenpay/internal-core)
# ARCENPAY_CONTRACT_5042002_planFactory=0x...
# ARCENPAY_CONTRACT_5042002_subscriptionRegistry=0x...
# ARCENPAY_CONTRACT_5042002_autopayModule=0x...
# ARCENPAY_CONTRACT_5042002_feeCollector=0x...
# ARCENPAY_CONTRACT_5042002_sessionVault=0x...
# ARCENPAY_CONTRACT_5042002_zkUsageVerifier=0x...
# ARCENPAY_CONTRACT_5042002_mirrorRegistry=0x...

# ── BOT Chain (EVM) ─────────────────────────────────────────────────────────────
# Run a SEPARATE facilitator deployment for BOT Chain (one CHAIN_ID per
# facilitator process — see apps/facilitator/src/server.ts). Do not point an
# existing Arc Testnet facilitator at this chain; stand up a new instance:
#   CHAIN_ID=968                     (BOT Chain Testnet — deploy/test here first)
#   CHAIN_ID=677                     (BOT Chain Mainnet)
#
# ⚠️ CRITICAL: BOT Chain's default public RPC (https://rpc.botchain.ai) has
# `eth_getLogs` DISABLED per BOT Chain's own docs. The facilitator's event
# pipeline (EventListenerService) polls via getLogs every ~15s — billing
# events will NEVER be detected if RPC_URL / RPC_URL_677 points at the
# default endpoint. You MUST supply a getLogs-capable 3rd-party RPC before
# running this against BOT Chain Mainnet in production.
# RPC_URL=<getLogs-capable BOT Chain RPC — NOT https://rpc.botchain.ai as-is>
# RPC_URL_677=<getLogs-capable BOT Chain Mainnet RPC>
# RPC_URL_968=https://rpc.bohr.life
#
# Contract addresses (set after deploying via `hardhat run --network botMainnet` /
# `--network botTestnet` — see packages/contracts/hardhat.config.ts):
# ARCENPAY_CONTRACT_677_planFactory=0x...
# ARCENPAY_CONTRACT_677_subscriptionRegistry=0x...
# ARCENPAY_CONTRACT_677_autopayModule=0x...
# ARCENPAY_CONTRACT_677_feeCollector=0x...
# ARCENPAY_CONTRACT_677_sessionVault=0x...
# ARCENPAY_CONTRACT_677_zkUsageVerifier=0x...
# ARCENPAY_CONTRACT_677_mirrorRegistry=0x...
#
# NOTE: BOT Chain has no canonical USDC — only a bridged USDT (see
# packages/internal-core/src/chains.ts TOKENS[677]). Confirm USDT is the
# intended settlement asset before enabling billing on this chain.

# ── Redis / Queue ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_REQUIRED=false

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email Notifications (optional) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=billing@arcenpay.xyz
BRAND_NAME=ArcenPay

# ── Dashboard Integration ───────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
# Optional team id for dashboard sync routes
# DASHBOARD_TEAM_ID=team_xxx
# Must match apps/arcen-dashboard FACILITATOR_SECRET
FACILITATOR_SECRET=your_shared_secret_here

# ── ERC-4337 Paymaster (testnet) ───────────────────────────────────────────────
PIMLICO_API_KEY=pim_your_api_key_here
PAYMASTER_RPC_URL_84532=https://api.pimlico.io/v2/84532/rpc?apikey=pim_your_api_key_here
PAYMASTER_RPC_URL_5042002=https://api.pimlico.io/v2/5042002/rpc?apikey=pim_your_api_key_here
# Optional generic fallback (single-chain setups only):
# PAYMASTER_RPC_URL=https://api.pimlico.io/v2/84532/rpc?apikey=pim_your_api_key_here
PAYMASTER_CHAIN_IDS=84532,5042002
PAYMASTER_ENTRYPOINT=0x0000000071727de22e5e9d8baf0edac6f37da032
PAYMASTER_RPC_METHOD=pm_sponsorUserOperation
# PAYMASTER_RPC_AUTH_TOKEN=
PAYMASTER_ESTIMATED_GAS_USED=120000
PAYMASTER_ESTIMATED_GAS_COST_USD=0.05

# ── Webhooks (optional) ─────────────────────────────────────────────────────────
# WEBHOOK_URL=https://your-webhook-endpoint.example
WEBHOOK_SIGNING_SECRET=whsec_change_me

# ── Tableland (optional) ────────────────────────────────────────────────────────
# Enables on-chain entitlement storage (decentralised feature flag mirror).
# Step 1: Run `npm run tableland:create` from the repo root.
#         This creates the table on Ethereum Sepolia and prints the table name.
#         Get free Sepolia ETH: https://sepoliafaucet.com
# Step 2: Uncomment and fill in the values below.
# If TABLELAND_TABLE_NAME is unset, facilitator uses in-memory flags fallback.
# TABLELAND_TABLE_NAME=arcenpay_entitlements_11155111_<tableId>
# TABLELAND_PRIVATE_KEY=0xYOUR_TABLELAND_KEY
TABLELAND_CHAIN=ethereum-sepolia
# TABLELAND_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# TABLELAND_GATEWAY_URL=https://testnets.tableland.network

# ── BillingKeeper — ERC7579 AutopayModule automation ────────────────────────────
# When enabled, the keeper polls for expiring subscriptions and calls
# ERC7579AutopayModule.execute() to trigger automatic renewal.
# Requires PRIVATE_KEY to be set (used as the keeper signer).
ENABLE_BILLING_KEEPER=false
# How often to poll for expiring subscriptions (milliseconds)
KEEPER_INTERVAL_MS=60000
# Renew subscriptions expiring within this many seconds (default: 1 day)
KEEPER_RENEWAL_BUFFER_SECONDS=86400
# Max subscriptions processed per keeper run
KEEPER_BATCH_SIZE=20

# ── Stellar (Soroban) chain ─────────────────────────────────────────────────────
# Run the facilitator on a Stellar synthetic chain:
#   CHAIN_ID=9000001                 (Stellar testnet)
#   CHAIN_ID=9000000                 (Stellar mainnet)
# The StellarChainAdapter resolves its Soroban RPC + passphrase from the chain
# registry. Override with:
#   STELLAR_RPC_URL_9000001=https://soroban-testnet.stellar.org
# Contract addresses (C…) per chain, e.g.:
#   ARCENPAY_CONTRACT_9000001_autopayModule=C…
#   ARCENPAY_CONTRACT_9000001_subscriptionRegistry=C…
#   ARCENPAY_CONTRACT_9000001_planFactory=C…
#   ARCENPAY_CONTRACT_9000001_feeCollector=C…
#   ARCENPAY_CONTRACT_9000001_sessionVault=C…
# On Stellar the settlement/keeper keys are S… secrets, not 0x hex.

# ── Stellar Renewal Driver ──────────────────────────────────────────────────────
# The Soroban analog of the EVM BillingKeeper: when enabled, the driver polls the
# configured subscribers' autopay configs and submits `autopay-account.execute`
# once each subscriber's billing interval has elapsed, auto-deducting USDC and
# rolling the subscription forward. Soroban requires the SUBSCRIBER's signature
# on every charge, so only subscribers whose S… secrets are listed here can be
# auto-renewed (test/demo/self-hosted agent wallets). Other due renewals are
# surfaced as log notices for the co-sign flow.
STELLAR_RENEWAL_DRIVER_ENABLED=false
# Comma-separated "G…:S…" subscriber keypairs to auto-renew.
# STELLAR_RENEWAL_KEYS=GABCD…:SABCD…,GEFGH…:SEFGH…
# How often to scan for due renewals (milliseconds).
STELLAR_RENEWAL_DRIVER_INTERVAL_MS=60000

# ── Lit Protocol (optional) ─────────────────────────────────────────────────────
LIT_NETWORK=datil-dev

# ── Cross-chain Transport (optional) ───────────────────────────────────────────
# Axelar
# AXELAR_GATEWAY_ADDRESS=0x...
# AXELAR_GAS_SERVICE_ADDRESS=0x...
# CCIP
# CCIP_ROUTER_ADDRESS=0x...
# CCIP_LINK_TOKEN_ADDRESS=0x...
