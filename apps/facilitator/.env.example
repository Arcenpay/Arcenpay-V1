# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3402
NODE_ENV=development

# ── Chain / RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# ── Operator Keys ───────────────────────────────────────────────────────────────
# Used for keeper (autopay trigger), settler (zk proof submission), and signing
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── x402 Payment Config ──────────────────────────────────────────────────────────
X402_ENABLE_SETTLEMENT=true
X402_REQUIRE_SETTLER_AUTH=true

# ── Contract Addresses (Sepolia) ────────────────────────────────────────────────
SESSION_VAULT_ADDRESS=0x2dccEaad8551a620E4Fc736bb4d0fbb8D1A17D7C
ZK_USAGE_VERIFIER_ADDRESS=0x265E0dC80b00044d183AFa83237F5976bB4d585c
PLAN_FACTORY_ADDRESS=0xc736f5d91aC0039b97A4Fc3540B8f3d59E7FdBa6
SUBSCRIPTION_REGISTRY_ADDRESS=0xf45A9E5280F72260a713c50b0Ca4e4FB1e22Cc8A
FEE_COLLECTOR_ADDRESS=0x513fab5218045790364b33A38D95FE8E17403BAe

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ── Email Notifications (optional) ──────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_...
EMAIL_FROM=billing@arcenpay.xyz

# ── Dashboard Integration ────────────────────────────────────────────────────────
# URL of the running ArcenPay dashboard (for subscriber email lookup fallback)
DASHBOARD_URL=http://localhost:3000
# Shared secret — must match the FACILITATOR_SECRET set in apps/arcen-dashboard/.env
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACILITATOR_SECRET=your_shared_secret_here

# ── Webhook Signing Secret ───────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_change_me

# ── Tableland ───────────────────────────────────────────────────────────────────
TABLELAND_PRIVATE_KEY=0xYOUR_TABLELAND_KEY
TABLELAND_CHAIN=ethereum-sepolia

# ── Lit Protocol ────────────────────────────────────────────────────────────────
LIT_NETWORK=datil-dev
