# ============================================================
#  Facilitator env file for a SEPARATE process instance dedicated
#  to BOT Chain Testnet (chainId 968).
#
#  This does NOT replace or touch your existing apps/facilitator/.env
#  (which stays pointed at Arc Testnet / whatever it currently runs).
#  Copy this file to `.env.bot-testnet`, fill in the blanks, then run:
#
#    cd apps/facilitator
#    FACILITATOR_ENV_FILE=.env.bot-testnet npm run dev
#    # or in production:
#    FACILITATOR_ENV_FILE=.env.bot-testnet npm run build && \
#      FACILITATOR_ENV_FILE=.env.bot-testnet npm start
#
#  `.env.bot-testnet` (without `.example`) is already covered by the same
#  .gitignore rule as `.env` — never commit it with real secrets filled in.
# ============================================================

# ── Profile / Server ────────────────────────────────────────────────────────────
FACILITATOR_PROFILE=development
# Use a different port than your existing facilitator instance if running
# both processes on the same machine at the same time.
PORT=3403
NODE_ENV=development

# ── Chain / RPC ─────────────────────────────────────────────────────────────────
CHAIN_ID=968

# ⚠️ https://rpc.bohr.life is BOT Chain Testnet's own documented public RPC.
# Confirm it supports eth_getLogs before relying on it for the event listener
# (the mainnet public endpoint explicitly does NOT — testnet has not been
# independently verified here). If events aren't arriving, this is the first
# thing to check; swap in a 3rd-party RPC via this same var.
RPC_URL=https://rpc.bohr.life

# ── Operator Keys ───────────────────────────────────────────────────────────────
# Facilitator signer for renewals (BillingKeeper) + settlements (SettlementWriter).
# Recommend a DIFFERENT key than your deployer key, funded with a small amount
# of testnet BOT for gas. Never commit this value.
PRIVATE_KEY=0xYOUR_BOT_TESTNET_FACILITATOR_SIGNER_KEY_HERE

# ── Contract Addresses (BOT Chain Testnet, chainId 968) ─────────────────────────
# Fill these in from deployments/botTestnet-latest.json after running:
#   cd packages/contracts
#   npx hardhat run scripts/deploy.ts --network botTestnet
# ARCENPAY_CONTRACT_968_planFactory=0x...
# ARCENPAY_CONTRACT_968_subscriptionRegistry=0x...
# ARCENPAY_CONTRACT_968_autopayModule=0x...
# ARCENPAY_CONTRACT_968_feeCollector=0x...
# ARCENPAY_CONTRACT_968_sessionVault=0x...
# ARCENPAY_CONTRACT_968_zkUsageVerifier=0x...
# ARCENPAY_CONTRACT_968_mirrorRegistry=0x...

# ── x402 Payment Config ──────────────────────────────────────────────────────────
X402_ENABLE_SETTLEMENT=true
X402_REQUIRE_SETTLER_AUTH=true

# ── Redis (optional — shares the same instance as your other facilitator if local) ─
REDIS_URL=redis://localhost:6380
REDIS_REQUIRED=false

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Dashboard bridge / auth ─────────────────────────────────────────────────────
# Same backend + shared secret as your existing facilitator — the backend is
# multi-chain aware via BillingEvent.payload.chainId, so both facilitator
# instances can point at the same backend.
DASHBOARD_URL=http://localhost:3000
BACKEND_URL=http://localhost:3300
FACILITATOR_SECRET=your_shared_secret_here

# ── BillingKeeper — leave OFF until you've smoke-tested settlement manually ────
ENABLE_BILLING_KEEPER=false
KEEPER_INTERVAL_MS=60000
KEEPER_RENEWAL_BUFFER_SECONDS=86400
KEEPER_BATCH_SIZE=20
