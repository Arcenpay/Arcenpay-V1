# ============================================================
#  ArcenPay Facilitator — Production Environment Variables
#  Copy to .env and fill in real values before deploying.
#  All variables marked REQUIRED will cause startup to fail
#  when FACILITATOR_PROFILE=production.
# ============================================================

# ── Runtime profile ───────────────────────────────────────────
# REQUIRED — set to "production" to enable all production guards
FACILITATOR_PROFILE=production

# ── RPC & Chain ───────────────────────────────────────────────
# REQUIRED in production — use a paid provider, not public nodes
RPC_URL=https://base-mainnet.infura.io/v3/YOUR_KEY
CHAIN_ID=8453

# ── Facilitator Auth ─────────────────────────────────────────
# REQUIRED in production — must match FACILITATOR_SECRET in dashboard
FACILITATOR_SECRET=a-long-random-secret-at-least-32-chars

# ── Server ────────────────────────────────────────────────────
PORT=3402

# ── Redis ─────────────────────────────────────────────────────
# Set REDIS_REQUIRED=true to enforce Redis presence at startup
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=true

# ── ZK Proof ──────────────────────────────────────────────────
# REQUIRED in production — paths to compiled circuit artifacts
PROOF_MODE=strict
ZK_CIRCUIT_WASM_PATH=/app/circuits/build/UsageBilling_js/UsageBilling.wasm
ZK_CIRCUIT_ZKEY_PATH=/app/circuits/build/circuit_final.zkey
ZK_CIRCUIT_VKEY_PATH=/app/circuits/build/verification_key.json
PROOF_SIGNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Webhooks ──────────────────────────────────────────────────
# Optional — set both or neither
# WEBHOOK_URL=https://your-webhook-receiver.com/hooks
# WEBHOOK_SIGNING_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# ── Dashboard (for DB sync) ───────────────────────────────────
# Optional — enables writing webhook delivery logs to the dashboard DB
# DASHBOARD_URL=https://app.arcenpay.xyz
# DASHBOARD_TEAM_ID=team_XXXX

# ── Tableland ─────────────────────────────────────────────────
# Optional — required if using Tableland for on-chain feature flags
# TABLELAND_TABLE_NAME=arcenpay_flags_11155111_123
# TABLELAND_PRIVATE_KEY=0xYOUR_TABLELAND_PRIVATE_KEY

# ── Sentry ────────────────────────────────────────────────────
# Optional — error tracking
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
