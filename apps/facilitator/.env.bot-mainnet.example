# ============================================================
#  Facilitator env file for a SEPARATE process instance dedicated
#  to BOT Chain Mainnet (chainId 677).
#
#  This does NOT replace or touch your existing apps/facilitator/.env
#  Copy this file to `.env.bot-mainnet`, fill in the blanks, then run:
#
#    cd apps/facilitator
#    FACILITATOR_ENV_FILE=.env.bot-mainnet npm run dev
#    # or in production:
#    FACILITATOR_ENV_FILE=.env.bot-mainnet npm run build && \
#      FACILITATOR_ENV_FILE=.env.bot-mainnet npm start
#
#  `.env.bot-mainnet` (without `.example`) is already covered by the same
#  .gitignore rule as `.env` — never commit it with real secrets filled in.
# ============================================================

# ── Profile / Server ────────────────────────────────────────────────────────────
FACILITATOR_PROFILE=production
# Use a different port than other facilitator instances if running concurrently
PORT=3404
NODE_ENV=production

# ── Chain / RPC ─────────────────────────────────────────────────────────────────
CHAIN_ID=677

# ⚠️ BOT Chain docs state `eth_getLogs` is DISABLED on https://rpc.botchain.ai.
# For the facilitator EventListenerService to poll billing events, you must
# provide a getLogs-capable RPC endpoint here.
RPC_URL=https://rpc.botchain.ai

# ── Operator Keys ───────────────────────────────────────────────────────────────
# Facilitator signer for renewals (BillingKeeper) + settlements (SettlementWriter).
# Must be funded with native BOT token for gas. Never commit this value.
PRIVATE_KEY=0xYOUR_BOT_MAINNET_FACILITATOR_SIGNER_KEY_HERE

# ── Contract Addresses (BOT Chain Mainnet, chainId 677) ────────────────────────
# Deployed contracts (can also be read directly from internal-core registry):
ARCENPAY_CONTRACT_677_planFactory=0x09fD8422638F4d6eA05F6Dcb2FB15Bea6eC59f41
ARCENPAY_CONTRACT_677_feeCollector=0x17375ec258cDABEB491AB9ae3F78428BC26Aa382
ARCENPAY_CONTRACT_677_subscriptionRegistry=0xea549C49A1A97faC398F977BCC0D65256c5419d9
ARCENPAY_CONTRACT_677_sessionVault=0x118C32C629F47109CF21a306A72c447127084CF4
ARCENPAY_CONTRACT_677_zkUsageVerifier=0x0694CB91b9399869ecB5942EF40AbD6C835Ba83a
ARCENPAY_CONTRACT_677_autopayModule=0xB240841d1c886455aC0620bB0A0AE1C194f3e275
ARCENPAY_CONTRACT_677_mirrorRegistry=0xE8E068FC93E9687c7D85d303312Ac13806e73e2F

# ── x402 Payment Config ──────────────────────────────────────────────────────────
X402_ENABLE_SETTLEMENT=true
X402_REQUIRE_SETTLER_AUTH=true

# ── Redis (optional — shares the same instance as your other facilitator if local) ─
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://app.arcenpay.com

# ── Dashboard bridge / auth ─────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
BACKEND_URL=http://localhost:3300
FACILITATOR_SECRET=your_shared_secret_here

# ── BillingKeeper ──────────────────────────────────────────────────────────────
ENABLE_BILLING_KEEPER=true
KEEPER_INTERVAL_MS=60000
KEEPER_RENEWAL_BUFFER_SECONDS=86400
KEEPER_BATCH_SIZE=20
