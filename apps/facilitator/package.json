{
  "name": "@arcenpay/facilitator",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "ArcenPay Facilitator Node — x402 payment validation and on-chain submission",
  "scripts": {
    "predev": "npm run build --workspace=@arcenpay/internal-core && npm run build --workspace=@arcenpay/node",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arcenpay/internal-core": "*",
    "@arcenpay/node": "^1.0.0",
    "@lit-protocol/constants": "^7.4.0",
    "@lit-protocol/encryption": "^7.4.0",
    "@lit-protocol/lit-node-client": "^7.4.0",
    "@sentry/node": "^8.0.0",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^16.2.0",
    "@tableland/sdk": "^7.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.5",
    "express": "^5.0.0",
    "ioredis": "^5.3.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
