{
  "name": "@arcenpay/facilitator",
  "version": "0.0.1",
  "private": true,
  "description": "MEAP Facilitator Node — x402 payment validation and on-chain submission",
  "scripts": {
    "prebuild": "npm run build --workspace=@arcenpay/internal-core",
    "pretypecheck": "npm run build --workspace=@arcenpay/internal-core",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arcenpay/internal-core": "*",
    "@arcenpay/node": "*",
    "@sentry/node": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "ioredis": "^5.3.0",
    "prom-client": "^15.1.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
