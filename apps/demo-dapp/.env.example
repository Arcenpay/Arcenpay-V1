# ArcenPay Demo dApp Configuration
# Copy this to .env and fill in your values

# Required: Get your API key from Dashboard → Settings → API Keys
# Publishable (pk_) is browser-safe. Secret (sk_) / restricted (rk_) go on your backend only.
VITE_ARCENPAY_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Required: Get your component ID from Dashboard → Settings → Components
VITE_ARCENPAY_COMPONENT_ID=

# Optional: Target chain ID (677 = BOT Mainnet, 8453 = Base, 5042002 = Arc Testnet, 9000000 = Stellar)
VITE_ARCENPAY_CHAIN_ID=677
