{
  "name": "recipt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend dev:inngest",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3002/api/inngest",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint app actions components convex hooks inngest lib middleware.ts next.config.ts --ignore-pattern 'convex/_generated/**' --ignore-pattern 'next-env.d.ts'"
  },
  "dependencies": {
    "@arcenpay/node": "*",
    "@arcenpay/react": "*",
    "@clerk/nextjs": "^6.12.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@inngest/agent-kit": "^0.13.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.28.0",
    "framer-motion": "^12.23.24",
    "inngest": "^3.44.4",
    "lucide-react": "^0.552.0",
    "next": "15.5.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "wagmi": "^2.19.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "npm-run-all2": "^5.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
