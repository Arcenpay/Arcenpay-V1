# ArcenPay Demo — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── ArcenPay Dashboard ──────────────────────────────────────────────
# Public browser key used by @arcenpay/react
NEXT_PUBLIC_ARCENPAY_PUBLISHABLE_KEY=pk_your_key_here

# Server-side API key used by demo API routes and @arcenpay/node
ARCENPAY_API_KEY=api_your_key_here

# Optional: point the demo at a local/staging dashboard instead of app.arcenpay.com
# NEXT_PUBLIC_ARCENPAY_BASE_URL=http://localhost:3000

# Component ID from Connections → Components in your dashboard
NEXT_PUBLIC_ARCENPAY_COMPONENT_ID=

# ─── Wallet / Chain (optional — defaults to Base Sepolia testnet) ─────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=

# ─── Demo App Settings ────────────────────────────────────────────────
# Simulate a logged-in company wallet for demo purposes
DEMO_COMPANY_WALLET=0x0000000000000000000000000000000000000001
DEMO_COMPANY_ID=
