# ─── ArcenPay Dashboard ──────────────────────────────────────────────────────
# URL of your ArcenPay dashboard (local dev or deployed)
ARCEN_BASE_URL=http://localhost:3000

# Protocol API key — create in dashboard → Settings → Protocol Keys
ARCEN_API_KEY=api_your_key_here

# ─── Demo Config ─────────────────────────────────────────────────────────────
# Fallback company identifier used when no wallet is connected
DEMO_COMPANY_EMAIL=demo@acmescan.xyz

# ─── Client-Side (NEXT_PUBLIC_) ──────────────────────────────────────────────
# Chain ID for on-chain components (11155111 = Sepolia testnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# WalletConnect project ID (get one free at cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dashboard URL for ArcenEmbed component
NEXT_PUBLIC_ARCEN_BASE_URL=http://localhost:3000

# Demo company email (mirrors DEMO_COMPANY_EMAIL for client-side hooks)
NEXT_PUBLIC_DEMO_COMPANY_EMAIL=demo@acmescan.xyz

# Optional: custom RPC URLs per chain
# NEXT_PUBLIC_RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_RPC_URL=https://fallback-rpc.example.com
