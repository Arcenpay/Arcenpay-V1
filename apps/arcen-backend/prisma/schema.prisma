model CheckoutSession {
  id                  String                 @id @default(cuid())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  teamId              String
  environmentId       String?
  paymentLinkId       String?
  companyId           String?
  catalogAddOnId      String?
  invoiceId           String?
  paymentId           String?
  subscriptionStateId String?
  purpose             CheckoutSessionPurpose
  status              CheckoutSessionStatus  @default(PENDING)
  customerEmail       String?
  customerWallet      String?
  customerName        String?
  currency            String                 @default("USDC")
  amount              Decimal                @db.Decimal(20, 6)
  acceptedToken       String
  chainId             Int                    @default(84532)
  recipientWallet     String
  txHash              String?                @unique
  verificationError   String?
  successUrl          String?
  cancelUrl           String?
  expiresAt           DateTime?
  paidAt              DateTime?
  cancelledAt         DateTime?
  metadata            Json?

  team                Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment         WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  paymentLink         PaymentLink?          @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  company             ArcenCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  catalogAddOn        CatalogAddOn?         @relation(fields: [catalogAddOnId], references: [id], onDelete: SetNull)
  invoice             Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment             Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  subscriptionState   SubscriptionState?    @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)
  addOnGrants         CompanyAddOnGrant[]
  creditGrants        CompanyCreditGrant[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([teamId, status, createdAt])
  @@index([teamId, environmentId, status])
  @@index([teamId, paymentLinkId])
  @@index([teamId, companyId])
  @@index([teamId, catalogAddOnId])
  @@index([teamId, invoiceId])
  @@index([teamId, subscriptionStateId])
}

model CatalogFeatureFlag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String

  featureKey   String // unique key used in API calls (e.g., "scan")
  name         String
  description  String?
  defaultValue Boolean @default(false)

  // Feature type: boolean | event_based | trait_based
  featureType String @default("boolean")

  // For event_based features
  eventKey     String? // e.g., "scan" — matches ArcenEvent.name
  unitSingular String? // e.g., "Scan"
  unitPlural   String? // e.g., "Scans"

  // Visual
  icon String? // emoji icon shown in plan feature lists

  rules FlagRule[]
  team  Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, featureKey])
  @@index([teamId])
}

model FlagRule {
  id       String  @id @default(cuid())
  flagId   String
  priority Int // evaluation order — lower number = evaluated first
  value    Boolean // True or False to serve when this rule matches

  // 'manual' (default) | 'plan' — tracks auto-generated rules
  source   String? @default("manual")
  // For source='plan': the CatalogPlan.id that generated this rule
  sourceId String?

  conditions FlagRuleCondition[]
  flag       CatalogFeatureFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, priority])
  @@index([flagId, source, sourceId])
}

model FlagRuleCondition {
  id     String @id @default(cuid())
  ruleId String

  // criteriaType: base_plan | add_on | usage | company_trait | user_trait | zktls_claim
  criteriaType String
  // operator: is_one_of | is_less_than | is_greater_than | equals | contains | not_equals
  operator     String
  // JSON array of plan/add-on IDs or string values for is_one_of
  values       Json   @default("[]")

  // For usage criteria
  metricKey    String? // matches ArcenEvent.name (e.g., "scan")
  metricValue  Float? // threshold (e.g., 300)
  metricPeriod String? // "monthly" | "daily" | "weekly"

  // For company_trait / user_trait criteria
  traitKey String?

  // For zktls_claim criteria
  zktlsProviderId String? // Reclaim Protocol provider ID

  rule FlagRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model CompanyOverride {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String

  companyId  String
  featureKey String
  value      Boolean
  reason     String?

  company ArcenCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey])
  @@index([teamId, companyId])
}

// Short-lived tokens for embeddable component authentication
model EmbedAccessToken {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  teamId        String
  environmentId String?

  tokenHash String   @unique
  companyId String?
  userId    String?
  expiresAt DateTime

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, environmentId])
  @@index([expiresAt])
}

// External API keys for ArcenPay developer access
model ArcenApiKey {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  teamId        String
  environmentId String?

  name        String
  keyHash     String  @unique // argon2 hash of the actual key
  prefix      String // first 12 chars for display (e.g., api_abc12345..)
  description String?

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, environmentId])
}

// zkTLS proofs submitted via Reclaim Protocol
model ZkTlsProof {
  id         String   @id @default(cuid())
  verifiedAt DateTime @default(now())
  teamId     String

  companyId    String?
  userId       String?
  providerId   String // Reclaim Protocol provider ID
  providerName String // human-readable (e.g., "Stripe Subscription Status")
  claimData    Json // verified structured claims extracted from proof
  proofHash    String    @unique // prevents replay attacks
  expiresAt    DateTime?

  company ArcenCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    ArcenUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, companyId])
  @@index([teamId, providerId])
  @@index([expiresAt])
}

// Embeddable UI components
model EmbedComponent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  teamId        String
  environmentId String?

  name     String
  // JSON array of element configs (planManager, meteredFeatures, plansTable, etc.)
  elements Json   @default("[]")
  // Design settings: colors, typography, layout
  design   Json   @default("{}")

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, environmentId])
}

// ─── Agent Configuration & Dispatch ────────────────────────────────────────────

model ArcenAgentConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String   @unique

  autoTopUp          Json    @default("{\"mode\":\"off\",\"dailyLimit\":\"5.00\",\"perTxnLimit\":\"1.00\",\"threshold\":\"0.50\"}")
  dispatch           Json    @default("{\"enabled\":false,\"providers\":[],\"cooldownSeconds\":120,\"maxRetries\":3}")
  agentWalletAddress String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model ArcenDispatchRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String

  agentAddress   String
  amount         String
  reason         String
  status         String    @default("pending")
  provider       String
  providerTarget String
  respondedAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([teamId, createdAt])
}
