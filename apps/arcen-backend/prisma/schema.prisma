// ─── Web3 ArcenPay Protocol Layer ─────────────────────────────────────────────
// Companies, Users, Events, Feature Flags, Rules, Overrides, Access Tokens,
// API Keys, zkTLS Proofs, Embeddable Components

model ArcenCompany {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
  teamId        String
  environmentId String?

  name          String
  walletAddress String? // Primary Web3 identity
  email         String?
  externalId    String? // Caller's own internal UUID/ID
  logoUrl       String?
  traits        Json    @default("{}")

  // Active plan assignment (references CatalogPlan.id)
  activePlanId   String?
  // Active add-on IDs (JSON array of CatalogAddOn.id)
  activeAddOnIds Json    @default("[]")

  team                       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment                WorkspaceEnvironment?       @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  users                      ArcenUser[]
  overrides                  CompanyOverride[]
  events                     ArcenEvent[]
  zkProofs                   ZkTlsProof[]
  subscriptionState          SubscriptionState?
  billingBalance             BillingBalance?
  payments                   Payment[]
  invoices                   Invoice[]
  refunds                    Refund[]
  billingAdjustments         BillingAdjustment[]
  billingRecoveryTasks       BillingRecoveryTask[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  addOnGrants                CompanyAddOnGrant[]
  creditGrants               CompanyCreditGrant[]
  creditLedgerEntries        CreditLedgerEntry[]
  paymentLinks               PaymentLink[]
  checkoutSessions           CheckoutSession[]

  @@unique([teamId, environmentId, walletAddress])
  @@unique([teamId, environmentId, externalId])
  @@index([teamId, environmentId, email])
  @@index([teamId, environmentId, lastSeenAt])
}

model ArcenUser {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
  teamId        String
  environmentId String?

  companyId     String
  name          String?
  email         String?
  walletAddress String?
  clerkUserId   String?
  externalId    String?
  traits        Json    @default("{}")

  company     ArcenCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  zkProofs    ZkTlsProof[]

  @@unique([teamId, environmentId, walletAddress])
  @@unique([teamId, environmentId, clerkUserId])
  @@index([teamId, environmentId, companyId])
  @@index([teamId, environmentId, externalId])
  @@index([teamId, environmentId, email])
}

model ArcenEvent {
  id            String   @id @default(cuid())
  sentAt        DateTime @default(now())
  teamId        String
  environmentId String?

  eventType String // "track" | "identify" | "flag_check"
  name      String? // event key for track events (e.g., "scan")
  companyId String?
  userId    String?
  traits    Json    @default("{}")

  company     ArcenCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId, environmentId, name, companyId, sentAt])
  @@index([teamId, environmentId, eventType, sentAt])
  @@index([teamId, environmentId, companyId, sentAt])
}

model CompanyAddOnGrant {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  teamId            String
  companyId         String
  catalogAddOnId    String
  status            CompanyAddOnGrantStatus @default(ACTIVE)
  source            CompanyAddOnGrantSource
  paymentId         String?
  checkoutSessionId String?
  grantedAt         DateTime                @default(now())
  expiresAt         DateTime?
  cancelAtPeriodEnd Boolean                 @default(false)
  cancelledAt       DateTime?
  metadata          Json?

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company         ArcenCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogAddOn    CatalogAddOn     @relation(fields: [catalogAddOnId], references: [id], onDelete: Cascade)
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)

  @@index([teamId, companyId, status])
  @@index([teamId, catalogAddOnId, status])
  @@index([paymentId])
  @@index([checkoutSessionId])
}

model CompanyCreditGrant {
  id                String                   @id @default(cuid())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  teamId            String
  environmentId     String?
  companyId         String
  creditTypeId      String
  status            CompanyCreditGrantStatus @default(ACTIVE)
  source            CompanyCreditGrantSource
  initialAmount     Int
  remainingAmount   Int
  grantedAt         DateTime                 @default(now())
  expiresAt         DateTime?
  periodStartedAt   DateTime?
  periodEndsAt      DateTime?
  resetPeriod       String?
  paymentId         String?
  checkoutSessionId String?
  idempotencyKey    String?
  metadata          Json?

  team            Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment     WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company         ArcenCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creditType      CatalogCreditType     @relation(fields: [creditTypeId], references: [id], onDelete: Cascade)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession?      @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  ledgerEntries   CreditLedgerEntry[]

  @@unique([teamId, idempotencyKey])
  @@index([teamId, environmentId, companyId, creditTypeId, status])
  @@index([teamId, creditTypeId, status])
  @@index([companyId, creditTypeId, status, expiresAt])
  @@index([paymentId])
  @@index([checkoutSessionId])
}

model CreditLedgerEntry {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  occurredAt        DateTime              @default(now())
  teamId            String
  environmentId     String?
  companyId         String
  creditTypeId      String
  grantId           String?
  kind              CreditLedgerEntryKind
  amount            Int
  balanceAfter      Int?
  featureKey        String?
  eventId           String?
  paymentId         String?
  checkoutSessionId String?
  idempotencyKey    String?
  metadata          Json?

  team            Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment     WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company         ArcenCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creditType      CatalogCreditType     @relation(fields: [creditTypeId], references: [id], onDelete: Cascade)
  grant           CompanyCreditGrant?   @relation(fields: [grantId], references: [id], onDelete: SetNull)
  payment         Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession?      @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)

  @@unique([teamId, idempotencyKey])
  @@index([teamId, environmentId, companyId, creditTypeId, occurredAt])
  @@index([companyId, creditTypeId, occurredAt])
  @@index([grantId])
  @@index([eventId])
  @@index([paymentId])
  @@index([checkoutSessionId])
}

model PaymentLink {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  teamId          String
  environmentId   String?
  kind            PaymentLinkKind
  status          PaymentLinkStatus @default(ACTIVE)
  name            String
  slug            String            @unique
  description     String?
  companyId       String?
  catalogAddOnId  String?
  invoiceId       String?
  currency        String            @default("USDC")
  amount          Decimal           @db.Decimal(20, 6)
  acceptedToken   String
  chainId         Int               @default(84532)
  recipientWallet String
  successUrl      String?
  cancelUrl       String?
  expiresAt       DateTime?
  metadata        Json?

  team             Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment      WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company          ArcenCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  catalogAddOn     CatalogAddOn?         @relation(fields: [catalogAddOnId], references: [id], onDelete: SetNull)
  invoice          Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  checkoutSessions CheckoutSession[]

  @@index([teamId, status, kind])
  @@index([teamId, environmentId, status])
  @@index([teamId, companyId])
  @@index([teamId, catalogAddOnId])
  @@index([teamId, invoiceId])
