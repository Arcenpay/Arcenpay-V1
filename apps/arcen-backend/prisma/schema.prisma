// ArcenPay Dashboard — Prisma Schema
// Core entities:
//   User / Team / TeamMember / ProviderProfile
// Added production domains:
//   Catalog, Templates, Invoices, Audit, Billing/Webhook durability

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TeamRole {
  OWNER
  ADMIN
  FINANCE
  DEVELOPER
  SUPPORT
  MEMBER
}

enum EnvironmentMode {
  DEVELOPMENT
  PRODUCTION
}

enum CatalogEntityType {
  PLAN
  ADDON
  CREDIT
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChainSyncStatus {
  PENDING
  SYNCED
  FAILED
  NOT_APPLICABLE
}

enum AddOnBillingType {
  ONE_TIME
  RECURRING
}

enum AddOnSaleMode {
  STANDALONE
  UPSELL
  BOTH
}

enum TemplateInstallStatus {
  INSTALLED
  UNINSTALLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum InvoiceDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum BillingEventType {
  SUBSCRIPTION_MINTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  PAYMENT_FAILED
  CREDIT_ISSUED
}

enum PaymentKind {
  SUBSCRIPTION_ACTIVATION
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_PLAN_CHANGE_UPGRADE
  MANUAL_INVOICE_PAYMENT
  ADDON_PURCHASE
  CUSTOM_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CompanyAddOnGrantStatus {
  ACTIVE
  CANCELLED
  REVOKED
  EXPIRED
}

enum CompanyAddOnGrantSource {
  ADMIN
  ADDON_PURCHASE
  PAYMENT_LINK
  INVOICE
  SUBSCRIPTION_UPSELL
}

enum CompanyCreditGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum CompanyCreditGrantSource {
  PLAN_GRANT
  CREDIT_BUNDLE
  ADMIN
  ADJUSTMENT
}

enum CreditLedgerEntryKind {
  GRANT
  CONSUME
  REFUND
  ADJUSTMENT
  EXPIRE
  REVOKE
}

enum PaymentLinkKind {
  ADDON
  INVOICE
  CUSTOM
}

enum PaymentLinkStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CheckoutSessionPurpose {
  ADDON
  INVOICE
  CUSTOM
}

enum CheckoutSessionStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingRecoveryTaskKind {
  SUBSCRIPTION_ACTIVATION
  SUBSCRIPTION_PLAN_CHANGE
  SUBSCRIPTION_CANCELLATION
  SUBSCRIPTION_RESUME
}

enum BillingRecoveryTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionChangeType {
  UPGRADE
  DOWNGRADE
  CANCELLATION
  RESUME
  BILLING_PERIOD_CHANGE
}

enum SubscriptionChangeStage {
  REQUESTED
  PENDING_VERIFICATION
  PENDING_RECOVERY
  APPLIED
  FAILED
  REVERTED
}

enum SubscriptionChangeSource {
  SELF_SERVICE
  ADMIN
  RECOVERY
  SYNC
}

enum BillingAdjustmentKind {
  UPGRADE_PRORATION_CHARGE
  DOWNGRADE_PRORATION_CREDIT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum BillingAdjustmentStatus {
  PENDING
  POSTED
  VOIDED
}

enum RefundStatus {
  PENDING
  SETTLED
  FAILED
  VOIDED
}

enum AuditActorType {
  USER
  API
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PlatformTier {
  FREE
  PLUS
  PRO
}

// ─── Core identity ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email         String? @unique
  emailVerified Boolean @default(false)
  walletAddress String? @unique

  currentTeamId String?

  authSessions   AuthSession[]
  emailAuthCodes EmailAuthCode[]
  invitedTeams   TeamInvitation[] @relation("TeamInvitationInvitedBy")
  teams          TeamMember[]

  @@index([email])
  @@index([walletAddress])
}

// ─── Dashboard auth ───────────────────────────────────────────────────────────

model AuthSession {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  userId              String
  activeEnvironmentId String?

  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeEnvironment WorkspaceEnvironment? @relation(fields: [activeEnvironmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeEnvironmentId])
}

model EmailAuthCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email        String
  purpose      String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

// ─── Teams / Workspaces ───────────────────────────────────────────────────────

model Team {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  name            String
  slug            String          @unique
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  invoicePrefix   String?

  // Platform tier (ArcenPay's own billing tier for this workspace)
  platformTier       PlatformTier @default(FREE)
  tierExpiresAt      DateTime?
  tierSubscriptionId String? // On-chain subscription tokenId for self-billing

  members          TeamMember[]
  providerProfiles ProviderProfile[]
  invitations      TeamInvitation[]
  environments     WorkspaceEnvironment[]

  catalogPlans        CatalogPlan[]
  catalogAddOns       CatalogAddOn[]
  catalogCreditTypes  CatalogCreditType[]
  creditLedgerEntries CreditLedgerEntry[]
  catalogVersions     CatalogVersion[]
  catalogConfigs      CatalogConfig[]

  billingTemplates BillingTemplate[]
  templateInstalls TemplateInstall[]

  invoices                   Invoice[]
  payments                   Payment[]
  paymentLinks               PaymentLink[]
  checkoutSessions           CheckoutSession[]
  billingBalances            BillingBalance[]
  refunds                    Refund[]
  billingAdjustments         BillingAdjustment[]
  subscriptionStates         SubscriptionState[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  billingRecoveryTasks       BillingRecoveryTask[]
  taxProfile                 TaxProfile?
  invoiceSequences           InvoiceSequence[]

  auditEvents       AuditEvent[]
  billingEvents     BillingEvent[]
  webhookDeliveries WebhookDelivery[]
  gasSpends         GasSpend[]
  tierHistory       TierUpgradeHistory[]
  supportTickets    SupportTicket[]

  // Web3 ArcenPay Protocol Layer
  arcenCompanies    ArcenCompany[]
  addOnGrants       CompanyAddOnGrant[]
  creditGrants      CompanyCreditGrant[]
  featureFlags      CatalogFeatureFlag[]
  arcenApiKeys      ArcenApiKey[]
  embedAccessTokens EmbedAccessToken[]
  embedComponents   EmbedComponent[]
  agentConfig       ArcenAgentConfig?
  dispatchRequests  ArcenDispatchRequest[]
  profileData       Json?

  @@index([slug])
  @@index([platformTier])
}

model WorkspaceEnvironment {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  teamId    String
  name      String
  mode      EnvironmentMode
  chainId   Int

  team                       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authSessions               AuthSession[]
  catalogPlans               CatalogPlan[]
  catalogAddOns              CatalogAddOn[]
  catalogCreditTypes         CatalogCreditType[]
  catalogVersions            CatalogVersion[]
  catalogConfigs             CatalogConfig[]
  companyCreditGrants        CompanyCreditGrant[]
  creditLedgerEntries        CreditLedgerEntry[]
  templateInstalls           TemplateInstall[]
  invoices                   Invoice[]
  subscriptionStates         SubscriptionState[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  payments                   Payment[]
  paymentLinks               PaymentLink[]
  checkoutSessions           CheckoutSession[]
  providerProfiles           ProviderProfile[]
  arcenApiKeys               ArcenApiKey[]
  embedAccessTokens          EmbedAccessToken[]
  embedComponents            EmbedComponent[]
  arcenCompanies             ArcenCompany[]
  arcenUsers                 ArcenUser[]
  arcenEvents                ArcenEvent[]

  @@unique([teamId, name])
  @@index([teamId, mode])
  @@index([teamId, chainId])
}

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  role   TeamRole @default(MEMBER)
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model TeamInvitation {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  teamId          String
  email           String
  role            TeamRole  @default(MEMBER)
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedByUser User? @relation("TeamInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([email])
  @@index([expiresAt])
}

model ProviderProfile {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  environmentId String?

  providerName String?
  website      String?
  contactEmail String?
  legalName    String?
  billingEmail String?
  supportEmail String?
  supportPhone String?
  supportUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  taxId        String?
  gstin        String?

  notifyEmail          Boolean @default(true)
  notifyWebhook        Boolean @default(false)
  webhookUrl           String?
  webhookSigningSecret String?

  // Per-event notification preferences stored as JSON array of
  // { id: string, email: boolean, webhook: boolean }
  notificationPreferences Json?

  apiKeyHash   String? @unique
  apiKeyPrefix String?

  teamId      String
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([teamId, environmentId])
  @@index([teamId])
  @@index([teamId, environmentId])
}

// ─── Subscriber email registry ────────────────────────────────────────────────

model SubscriberEmail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopeKey      String  @default("legacy")
  teamId        String?
  environmentId String?
  companyId     String?
  walletAddress String
  email         String
  planId        String?

  @@unique([scopeKey, walletAddress])
  @@index([walletAddress])
  @@index([teamId, environmentId, walletAddress])
  @@index([companyId])
  @@index([email])
}

// ─── Auth nonce store ─────────────────────────────────────────────────────────

model AuthNonce {
  nonce     String    @id
  issuedAt  String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

// ─── Catalog (Plans / Add-ons / Credits) ─────────────────────────────────────

model CatalogPlan {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentId   String?
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name            String
  tier            String
  description     String?
  price           Decimal  @db.Decimal(20, 6)
  annualPrice     Decimal? @db.Decimal(20, 6)
  billingInterval Int
  acceptedToken   String
  metadata        Json?

  active      Boolean   @default(true)
  version     Int       @default(1)
  publishedAt DateTime?

  // On-chain identity — chainId tells us which network this plan is registered on.
  // Default 84532 = Base Sepolia (matches historic DEFAULT_CHAIN_ID).
  chainId         Int             @default(84532)
  onChainPlanId   String?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId, environmentMode, status])
  @@index([teamId, environmentId, status])
  @@index([teamId, name])
  @@index([teamId, chainId, onChainPlanId])
}

model CatalogAddOn {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentId   String?
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name                String
  code                String
  description         String?
  billingType         AddOnBillingType @default(ONE_TIME)
  saleMode            AddOnSaleMode    @default(STANDALONE)
  price               Decimal          @db.Decimal(20, 6)
  billingIntervalDays Int?
  acceptedToken       String
  metadata            Json?

  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team             Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment      WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  companyGrants    CompanyAddOnGrant[]
  paymentLinks     PaymentLink[]
  checkoutSessions CheckoutSession[]

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
  @@index([teamId, environmentId, status])
}

model CatalogCreditType {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentId   String?
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name          String
  code          String
  unitName      String
  unitsPerPack  Int
  price         Decimal @db.Decimal(20, 6)
  acceptedToken String

  metadata        Json?
  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team          Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment   WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  companyGrants CompanyCreditGrant[]
  ledgerEntries CreditLedgerEntry[]

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
  @@index([teamId, environmentId, status])
}

model CatalogVersion {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  publishedAt     DateTime?
  teamId          String
  environmentId   String?
  environmentMode EnvironmentMode   @default(DEVELOPMENT)
  entityType      CatalogEntityType
  entityId        String
  version         Int
  status          CatalogStatus     @default(DRAFT)
  snapshot        Json

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([teamId, entityType, entityId, version])
  @@index([teamId, environmentMode, status])
  @@index([teamId, environmentId, status])
}

model CatalogConfig {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentId   String?         @unique
  environmentMode EnvironmentMode @default(DEVELOPMENT)

  initialPlan                  String   @default("Free")
  fallbackPlan                 String?
  livePlanIds                  String[] @default([])
  liveAddOnIds                 String[] @default([])
  liveCreditTypeIds            String[] @default([])
  restrictLivePlans            Boolean  @default(false)
  restrictLiveAddOns           Boolean  @default(false)
  restrictLiveCreditTypes      Boolean  @default(false)
  showBillingPeriodToggle      Boolean  @default(true)
  freePlanPriceDisplay         Boolean  @default(true)
  hideCredits                  Boolean  @default(false)
  yearlyDiscountDisplay        Boolean  @default(true)
  showFeatureDescriptions      Boolean  @default(true)
  showHardLimits               Boolean  @default(true)
  upgradeImmediately           Boolean  @default(true)
  downgradeImmediately         Boolean  @default(false)
  preventDowngradeOverLimit    Boolean  @default(true)
  disallowSelfServiceDowngrade Boolean  @default(false)

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([teamId, environmentMode])
  @@index([teamId, environmentId])
}

model CatalogCoupon {
  teamId           String
  code             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  description      String?
  discountPercent  Int
  active           Boolean   @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  applicablePlanId String?
  billingPeriod    String?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)

  @@id([teamId, code])
  @@index([teamId, active])
  @@index([teamId, applicablePlanId])
}

// ─── Template Library ─────────────────────────────────────────────────────────

model BillingTemplate {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  teamId         String
  name           String
  slug           String
  description    String?
  status         CatalogStatus @default(DRAFT)
  currentVersion Int           @default(1)

  team     Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions BillingTemplateVersion[]
  installs TemplateInstall[]

  @@unique([teamId, slug])
  @@index([teamId, status])
}

model BillingTemplateVersion {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  templateId    String
  version       Int
  schemaJson    Json
  reactBlocks   Json
  styleTokens   Json
  compatibility Json

  template BillingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
}

model TemplateInstall {
  id               String                @id @default(cuid())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  teamId           String
  environmentId    String?
  templateId       String
  installedVersion Int
  environmentMode  EnvironmentMode       @default(DEVELOPMENT)
  chainId          Int
  status           TemplateInstallStatus @default(INSTALLED)

  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template    BillingTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  environment WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([teamId, templateId, environmentMode, chainId])
  @@index([teamId, environmentMode, status])
  @@index([teamId, environmentId, status])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model TaxProfile {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teamId      String   @unique
  legalName   String
  country     String
  taxId       String?
  gstin       String?
  addressJson Json
  taxRegime   String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamId     String
  year       Int
  lastNumber Int      @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, year])
  @@index([teamId])
}

model Invoice {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentId   String?
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          InvoiceStatus   @default(DRAFT)

  number         String? @unique
  currency       String  @default("USDC")
  customerEmail  String?
  customerWallet String?

  subtotal          Decimal @default(0) @db.Decimal(20, 6)
  taxTotal          Decimal @default(0) @db.Decimal(20, 6)
  total             Decimal @default(0) @db.Decimal(20, 6)
  amountPaid        Decimal @default(0) @db.Decimal(20, 6)
  amountCredited    Decimal @default(0) @db.Decimal(20, 6)
  amountOutstanding Decimal @default(0) @db.Decimal(20, 6)

  dueAt       DateTime?
  issuedAt    DateTime?
  paidAt      DateTime?
  externalRef String?
  planId      String?
  companyId   String?
  metadata    Json?

  team             Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment      WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company          ArcenCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lineItems        InvoiceLine[]
  deliveries       InvoiceDelivery[]
  creditNotes      CreditNote[]
  payments         Payment[]
  refunds          Refund[]
  paymentLinks     PaymentLink[]
  checkoutSessions CheckoutSession[]

  @@index([teamId, status, issuedAt])
  @@index([teamId, environmentMode])
  @@index([teamId, environmentId])
  @@index([companyId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  invoiceId   String
  description String
  quantity    Int      @default(1)

  unitAmount   Decimal @db.Decimal(20, 6)
  taxRate      Decimal @default(0) @db.Decimal(8, 4)
  lineSubtotal Decimal @db.Decimal(20, 6)
  lineTax      Decimal @default(0) @db.Decimal(20, 6)
  lineTotal    Decimal @db.Decimal(20, 6)

  metadata Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceDelivery {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  invoiceId         String
  provider          String                @default("resend")
  method            String                @default("email")
  status            InvoiceDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  externalMessageId String?
  errorMessage      String?
  sentAt            DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model CreditNote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  invoiceId  String
  noteNumber String   @unique
  reason     String
  amount     Decimal  @db.Decimal(20, 6)
  metadata   Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Audit / Durable event logs ───────────────────────────────────────────────

model AuditEvent {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  teamId       String
  actorType    AuditActorType
  actorUserId  String?
  actorAddress String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  ip           String?
  userAgent    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, action])
  @@index([requestId])
}

model BillingEvent {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  teamId         String
  eventType      BillingEventType
  idempotencyKey String           @unique
  source         String           @default("facilitator")
  payload        Json
  processed      Boolean          @default(false)
  processedAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, processed])
}

model SubscriptionState {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  teamId             String
  environmentId      String?
  companyId          String             @unique
  walletAddress      String?
  status             SubscriptionStatus @default(ACTIVE)
  catalogPlanId      String?
  onChainPlanId      String?
  onChainTokenId     String?
  // chainId records which chain this subscription is active on.
  // Default 84532 = Base Sepolia (matches historic DEFAULT_CHAIN_ID).
  chainId            Int                @default(84532)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastEvent          String?
  lastEventAt        DateTime?
  lastSourceTxHash   String?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  pastDueAt          DateTime?
  graceEndsAt        DateTime?
  metadata           Json?

  team               Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment        WorkspaceEnvironment?       @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company            ArcenCompany                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changeRequests     SubscriptionChangeRequest[]
  payments           Payment[]
  billingAdjustments BillingAdjustment[]
  checkoutSessions   CheckoutSession[]

  @@index([teamId, status])
  @@index([teamId, walletAddress])
  @@index([teamId, chainId])
  @@index([teamId, environmentId])
}

model SubscriptionChangeRequest {
  id                    String                   @id @default(cuid())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  teamId                String
  environmentId         String?
  companyId             String
  subscriptionStateId   String?
  changeType            SubscriptionChangeType
  stage                 SubscriptionChangeStage  @default(REQUESTED)
  source                SubscriptionChangeSource @default(SELF_SERVICE)
  previousPlanId        String?
  targetPlanId          String?
  previousBillingPeriod String?
  targetBillingPeriod   String?
  requestedAt           DateTime                 @default(now())
  effectiveAt           DateTime?
  appliedAt             DateTime?
  failedAt              DateTime?
  autopayConfigTxHash   String?
  accessChangeTxHash    String?
  paymentTxHash         String?
  autopayControlTxHash  String?
  recoveryTaskId        String?
  pendingVerification   Boolean                  @default(false)
  failureReason         String?
  metadata              Json?

  team              Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment       WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company           ArcenCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionState SubscriptionState?    @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)

  @@index([teamId, environmentId, companyId, stage, requestedAt])
  @@index([teamId, subscriptionStateId, createdAt])
  @@index([companyId, createdAt])
  @@index([recoveryTaskId])
  @@index([autopayConfigTxHash])
  @@index([accessChangeTxHash])
  @@index([paymentTxHash])
  @@index([autopayControlTxHash])
}

model Payment {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  teamId              String
  environmentId       String?
  companyId           String?
  invoiceId           String?
  subscriptionStateId String?
  idempotencyKey      String        @unique
  kind                PaymentKind
  status              PaymentStatus @default(PENDING)
  currency            String        @default("USDC")
  amount              Decimal       @db.Decimal(20, 6)
  payerWallet         String?
  recipientWallet     String?
  acceptedToken       String?
  txHash              String?       @unique
  externalRef         String?
  occurredAt          DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  metadata            Json?

  team                Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  environment         WorkspaceEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  company             ArcenCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoice             Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriptionState   SubscriptionState?    @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)
  attempts            PaymentAttempt[]
  billingAdjustments  BillingAdjustment[]
  refunds             Refund[]
  checkoutSessions    CheckoutSession[]
  addOnGrants         CompanyAddOnGrant[]
  creditGrants        CompanyCreditGrant[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([teamId, status, occurredAt])
  @@index([teamId, environmentId])
  @@index([companyId, createdAt])
  @@index([invoiceId])
  @@index([subscriptionStateId])
}

model PaymentAttempt {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  paymentId    String
  status       PaymentAttemptStatus
  txHash       String?
  errorCode    String?
  errorMessage String?
  attemptedAt  DateTime             @default(now())
  resolvedAt   DateTime?
  metadata     Json?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, attemptedAt])
  @@index([txHash])
}

model BillingAdjustment {
  id                  String                  @id @default(cuid())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  teamId              String
  companyId           String
  subscriptionStateId String?
  paymentId           String?
  kind                BillingAdjustmentKind
  status              BillingAdjustmentStatus @default(PENDING)
  currency            String                  @default("USDC")
  amount              Decimal                 @db.Decimal(20, 6)
  fromCatalogPlanId   String?
  toCatalogPlanId     String?
  periodStartedAt     DateTime?
  periodEndsAt        DateTime?
  effectiveAt         DateTime?
  postedAt            DateTime?
  voidedAt            DateTime?
  metadata            Json?

  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company           ArcenCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionState SubscriptionState? @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refunds           Refund[]

  @@index([teamId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([subscriptionStateId, createdAt])
  @@index([paymentId])
}

model BillingBalance {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  teamId          String
  companyId       String    @unique
  currency        String    @default("USDC")
  availableCredit Decimal   @default(0) @db.Decimal(20, 6)
