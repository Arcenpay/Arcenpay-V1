# ArcenPay Backend API — Environment Variables
# Copy to .env or .env.local and fill in

NODE_ENV=development
PORT=3300

# ── Database ──
DATABASE_URL=postgresql://arcenpay:arcenpay_dev@localhost:5432/arcenpay

# ── Auth ──
SIWE_JWT_SECRET=replace_with_strong_secret
ACCESS_TOKEN_SECRET=replace_with_strong_secret
FACILITATOR_SECRET=replace_with_shared_secret

# ── External Services ──
RESEND_API_KEY=
EMAIL_FROM=noreply@arcenpay.xyz
ARCJET_KEY=
SENTRY_DSN=

# ── Facilitator ──
FACILITATOR_URL=http://localhost:3402
DASHBOARD_URL=http://localhost:3000

# ── Blockchain ──
CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_ID=84532
MEAP_DEFAULT_CHAIN_ID=84532

# ── Invoice ──
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# ── Redis (for facilitator communication) ──
REDIS_URL=redis://localhost:6379
