# ============================================================
#  ArcenPay Backend API — Environment Variables
#  Standalone production server (Hono on port 3300)
# ============================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3300

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://arcenpay:arcenpay_dev@localhost:5433/arcenpay

# ── Auth Secrets ──────────────────────────────────────────────────────────────
SIWE_JWT_SECRET=replace_with_strong_secret
ACCESS_TOKEN_SECRET=replace_with_strong_secret
FACILITATOR_SECRET=replace_with_shared_secret
AUTH_COOKIE_DOMAIN=.arcenpay.com

# ── External Services ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@arcenpay.xyz
ARCJET_KEY=ajkey_xxx
SENTRY_DSN=

# ── Facilitator (on-chain transaction node) ───────────────────────────────────
FACILITATOR_URL=http://localhost:3402
FACILITATOR_BASE_URL_84532=http://localhost:3402
FACILITATOR_BASE_URL_5042002=http://localhost:3402

# ── Dashboard URL (CORS origin) ───────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Blockchain / Chain Config ─────────────────────────────────────────────────
CHAIN_ID=84532
ARCENPAY_DEFAULT_CHAIN_ID=84532

# ── RPC URLs (comma-separate for failover) ────────────────────────────────────
RPC_URL=https://sepolia.base.org
RPC_URL_84532=https://sepolia.base.org
RPC_URL_5042002=https://rpc.testnet.arc.network
RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_8453=https://mainnet.base.org

# ── ZeroDev / ERC-4337 ───────────────────────────────────────────────────────
ZERODEV_PROJECT_ID=
ZERODEV_MODE=sponsored

# ── Subgraph (The Graph) ──────────────────────────────────────────────────────
GRAPH_URL_84532=https://api.studio.thegraph.com/query/1744703/subscription-registry/version/latest

# ── Deployer / Signer Keys ────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x_xxx
PRIVATE_KEY=
ONCHAIN_PROVIDER_PRIVATE_KEY=0x_xxx
SUBSCRIPTION_BILLER_PRIVATE_KEY=0x_xxx
PLAN_FACTORY_OWNER_PRIVATE_KEY=0x_xxx

# ── Invoice ───────────────────────────────────────────────────────────────────
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Tableland (on-chain feature flag storage) ─────────────────────────────────
TABLELAND_TABLE_NAME=
TABLELAND_PRIVATE_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ARCENPAY_ENABLE_SELF_SERVE_PLAN_CHANGES=false
ARCENPAY_ENABLE_SELF_SERVE_CANCELLATION=false
ARCENPAY_REQUIRE_SUBGRAPH=false
# Keep false until mainnet contracts, RPC, facilitator, tokens, and treasury
# configuration have been reviewed and approved.
ARCENPAY_ENABLE_PRODUCTION_ENVIRONMENTS=false

# ── Contract Addresses (Base Sepolia, chain 84532) ────────────────────────────
ARCENPAY_CONTRACT_84532_planFactory=
ARCENPAY_CONTRACT_84532_subscriptionRegistry=
ARCENPAY_CONTRACT_84532_autopayModule=
ARCENPAY_CONTRACT_84532_feeCollector=
ARCENPAY_CONTRACT_84532_sessionVault=
ARCENPAY_CONTRACT_84532_zkUsageVerifier=
ARCENPAY_CONTRACT_84532_mirrorRegistry=

# ── USDC Address ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_USDC_ADDRESS_84532=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Hosted MCP server ─────────────────────────────────────────────────────────
# Mounts a read-only MCP endpoint at /mcp (Streamable HTTP) for AI assistants.
# OFF by default — set to true to expose it. Auth is an ArcenPay SECRET/RESTRICTED
# API key (Authorization: Bearer sk_/rk_…). Read-only: never moves funds.
MCP_SERVER_ENABLED=false
# Canonical public URL of the MCP resource. Used for OAuth protected-resource
# metadata once the OAuth layer lands; optional until then.
MCP_RESOURCE_URL=
# Domain-verification challenge token from the OpenAI plugin submission portal.
# Served verbatim as plain text at /.well-known/openai-apps-challenge.
MCP_DOMAIN_CHALLENGE_TOKEN=
# OAuth 2.1 issuer / resource origin for the hosted MCP server. ChatGPT
# connectors authenticate via OAuth, not static API keys. Defaults to
# MCP_RESOURCE_URL when unset.
MCP_OAUTH_ISSUER=
# HMAC secret for signing hosted MCP OAuth access tokens (openssl rand -hex 32).
# Leave empty to disable the OAuth endpoints (API-key auth still works).
MCP_OAUTH_SECRET=
