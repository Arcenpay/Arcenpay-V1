{
  "name": "@arcenpay/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ArcenPay Backend API — standalone production server (Hono)",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "prisma generate && tsx watch src/server.ts",
    "start": "node --import tsx dist/server.js",
    "lint": "prisma generate && tsc --noEmit --incremental false",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit --incremental false",
    "report:duplicate-subscription-charges": "tsx scripts/report-duplicate-subscription-charges.ts",
    "repair:platform-billing": "tsx scripts/repair-platform-billing.ts",
    "reset:platform-catalog": "tsx scripts/reset-platform-catalog.ts",
    "setup:platform-billing": "tsx scripts/setup-platform-billing.ts",
    "verify:stellar:renewal": "tsx scripts/verify-stellar-renewal.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@arcenpay/internal-core": "*",
    "@arcenpay/shared-types": "*",
    "@arcjet/node": "^1.4.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/node": "^8.55.0",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^16.2.0",
    "date-fns": "4.1.0",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "resend": "^6.9.3",
    "svix": "^1.84.1",
    "tsx": "^4.19.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.46.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.18.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
