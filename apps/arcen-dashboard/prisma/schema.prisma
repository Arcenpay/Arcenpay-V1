// ArcenPay Dashboard — Prisma Schema
// Core entities:
//   User / Team / TeamMember / ProviderProfile
// Added production domains:
//   Catalog, Templates, Invoices, Audit, Billing/Webhook durability

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TeamRole {
  OWNER
  ADMIN
  FINANCE
  DEVELOPER
  SUPPORT
  MEMBER
}

enum EnvironmentMode {
  DEVELOPMENT
  PRODUCTION
}

enum CatalogEntityType {
  PLAN
  ADDON
  CREDIT
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChainSyncStatus {
  PENDING
  SYNCED
  FAILED
  NOT_APPLICABLE
}

enum AddOnBillingType {
  ONE_TIME
  RECURRING
}

enum TemplateInstallStatus {
  INSTALLED
  UNINSTALLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum InvoiceDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum BillingEventType {
  SUBSCRIPTION_MINTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  PAYMENT_FAILED
  CREDIT_ISSUED
}

enum PaymentKind {
  SUBSCRIPTION_ACTIVATION
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_PLAN_CHANGE_UPGRADE
  MANUAL_INVOICE_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingRecoveryTaskKind {
  SUBSCRIPTION_ACTIVATION
}

enum BillingRecoveryTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BillingAdjustmentKind {
  UPGRADE_PRORATION_CHARGE
  DOWNGRADE_PRORATION_CREDIT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum BillingAdjustmentStatus {
  PENDING
  POSTED
  VOIDED
}

enum RefundStatus {
  PENDING
  SETTLED
  FAILED
  VOIDED
}

enum AuditActorType {
  USER
  API
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PlatformTier {
  FREE
  PLUS
  PRO
}

// ─── Core identity ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email         String? @unique
  emailVerified Boolean @default(false)
  walletAddress String? @unique

  currentTeamId String?

  authSessions    AuthSession[]
  emailAuthCodes  EmailAuthCode[]
  invitedTeams    TeamInvitation[] @relation("TeamInvitationInvitedBy")
  teams           TeamMember[]

  @@index([email])
  @@index([walletAddress])
}

// ─── Dashboard auth ───────────────────────────────────────────────────────────

model AuthSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String

  tokenHash String   @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailAuthCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email     String
  purpose   String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attemptCount Int   @default(0)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

// ─── Teams / Workspaces ───────────────────────────────────────────────────────

model Team {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  name            String
  slug            String          @unique
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  invoicePrefix   String?

  // Platform tier (ArcenPay's own billing tier for this workspace)
  platformTier       PlatformTier @default(FREE)
  tierExpiresAt      DateTime?
  tierSubscriptionId String?      // On-chain subscription tokenId for self-billing

  members         TeamMember[]
  providerProfile ProviderProfile?
  invitations     TeamInvitation[]

  catalogPlans       CatalogPlan[]
  catalogAddOns      CatalogAddOn[]
  catalogCreditTypes CatalogCreditType[]
  catalogVersions    CatalogVersion[]
  catalogConfigs     CatalogConfig[]

  billingTemplates BillingTemplate[]
  templateInstalls TemplateInstall[]

  invoices         Invoice[]
  payments         Payment[]
  billingBalances  BillingBalance[]
  refunds          Refund[]
  billingAdjustments BillingAdjustment[]
  subscriptionStates SubscriptionState[]
  billingRecoveryTasks BillingRecoveryTask[]
  taxProfile       TaxProfile?
  invoiceSequences InvoiceSequence[]

  auditEvents        AuditEvent[]
  billingEvents      BillingEvent[]
  webhookDeliveries  WebhookDelivery[]
  gasSpends          GasSpend[]
  tierHistory        TierUpgradeHistory[]
  supportTickets     SupportTicket[]

  // Web3 ArcenPay Protocol Layer
  arcenCompanies      ArcenCompany[]
  featureFlags        CatalogFeatureFlag[]
  arcenApiKeys        ArcenApiKey[]
  embedComponents     EmbedComponent[]

  @@index([slug])
  @@index([platformTier])
}

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  role   TeamRole @default(MEMBER)
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model TeamInvitation {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  teamId          String
  email           String
  role            TeamRole @default(MEMBER)
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedByUser User? @relation("TeamInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([email])
  @@index([expiresAt])
}

model ProviderProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerName  String?
  website       String?
  contactEmail  String?

  notifyEmail         Boolean @default(true)
  notifyWebhook       Boolean @default(false)
  webhookUrl          String?
  webhookSigningSecret String?

  // Per-event notification preferences stored as JSON array of
  // { id: string, email: boolean, webhook: boolean }
  notificationPreferences Json?

  apiKeyHash   String? @unique
  apiKeyPrefix String?

  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ─── Subscriber email registry ────────────────────────────────────────────────

model SubscriberEmail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletAddress String @unique
  email         String
  planId        String?

  @@index([walletAddress])
  @@index([email])
}

// ─── Auth nonce store ─────────────────────────────────────────────────────────

model AuthNonce {
  nonce     String   @id
  issuedAt  String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

// ─── Catalog (Plans / Add-ons / Credits) ─────────────────────────────────────

model CatalogPlan {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name           String
  tier           String
  description    String?
  price          Decimal          @db.Decimal(20, 6)
  annualPrice    Decimal?         @db.Decimal(20, 6)
  billingInterval Int
  acceptedToken  String
  metadata       Json?

  active      Boolean   @default(true)
  version     Int       @default(1)
  publishedAt DateTime?

  onChainPlanId   String?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, environmentMode, status])
  @@index([teamId, name])
}

model CatalogAddOn {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name        String
  code        String
  description String?
  billingType AddOnBillingType @default(ONE_TIME)
  price       Decimal          @db.Decimal(20, 6)
  acceptedToken String
  metadata    Json?

  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
}

model CatalogCreditType {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name         String
  code         String
  unitName     String
  unitsPerPack Int
  price        Decimal @db.Decimal(20, 6)
  acceptedToken String

  metadata    Json?
  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
}

model CatalogVersion {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  publishedAt     DateTime?
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  entityType      CatalogEntityType
  entityId        String
  version         Int
  status          CatalogStatus   @default(DRAFT)
  snapshot        Json

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, entityType, entityId, version])
  @@index([teamId, environmentMode, status])
}

model CatalogConfig {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)

  initialPlan                 String  @default("Free")
  fallbackPlan                String?
  showBillingPeriodToggle     Boolean @default(true)
  freePlanPriceDisplay        Boolean @default(true)
  hideCredits                 Boolean @default(false)
  yearlyDiscountDisplay       Boolean @default(true)
  showFeatureDescriptions     Boolean @default(true)
  showHardLimits              Boolean @default(true)
  upgradeImmediately          Boolean @default(true)
  downgradeImmediately        Boolean @default(false)
  preventDowngradeOverLimit   Boolean @default(true)
  disallowSelfServiceDowngrade Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, environmentMode])
  @@index([teamId, environmentMode])
}

model CatalogCoupon {
  teamId          String
  code            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  description     String?
  discountPercent Int
  active          Boolean  @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  applicablePlanId String?
  billingPeriod   String?
  maxRedemptions  Int?
  redemptionCount Int      @default(0)

  @@id([teamId, code])
  @@index([teamId, active])
  @@index([teamId, applicablePlanId])
}

// ─── Template Library ─────────────────────────────────────────────────────────

model BillingTemplate {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teamId        String
  name          String
  slug          String
  description   String?
  status        CatalogStatus @default(DRAFT)
  currentVersion Int          @default(1)

  team     Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions BillingTemplateVersion[]
  installs TemplateInstall[]

  @@unique([teamId, slug])
  @@index([teamId, status])
}

model BillingTemplateVersion {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  templateId    String
  version       Int
  schemaJson    Json
  reactBlocks   Json
  styleTokens   Json
  compatibility Json

  template BillingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
}

model TemplateInstall {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  teamId          String
  templateId      String
  installedVersion Int
  environmentMode EnvironmentMode     @default(DEVELOPMENT)
  chainId         Int
  status          TemplateInstallStatus @default(INSTALLED)

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template BillingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([teamId, environmentMode, status])
  @@unique([teamId, templateId, environmentMode, chainId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model TaxProfile {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teamId       String   @unique
  legalName    String
  country      String
  taxId        String?
  gstin        String?
  addressJson  Json
  taxRegime    String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamId     String
  year       Int
  lastNumber Int      @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, year])
  @@index([teamId])
}

model Invoice {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          InvoiceStatus   @default(DRAFT)

  number         String? @unique
  currency       String  @default("USDC")
  customerEmail  String?
  customerWallet String?

  subtotal Decimal @default(0) @db.Decimal(20, 6)
  taxTotal  Decimal @default(0) @db.Decimal(20, 6)
  total     Decimal @default(0) @db.Decimal(20, 6)
  amountPaid      Decimal @default(0) @db.Decimal(20, 6)
  amountCredited  Decimal @default(0) @db.Decimal(20, 6)
  amountOutstanding Decimal @default(0) @db.Decimal(20, 6)

  dueAt      DateTime?
  issuedAt   DateTime?
  paidAt     DateTime?
  externalRef String?
  planId      String?
  metadata    Json?

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lineItems  InvoiceLine[]
  deliveries InvoiceDelivery[]
  creditNotes CreditNote[]
  payments   Payment[]
  refunds    Refund[]

  @@index([teamId, status, issuedAt])
  @@index([teamId, environmentMode])
}

model InvoiceLine {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  invoiceId  String
  description String
  quantity   Int      @default(1)

  unitAmount Decimal @db.Decimal(20, 6)
  taxRate    Decimal @default(0) @db.Decimal(8, 4)
  lineSubtotal Decimal @db.Decimal(20, 6)
  lineTax      Decimal @default(0) @db.Decimal(20, 6)
  lineTotal    Decimal @db.Decimal(20, 6)

  metadata Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceDelivery {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  invoiceId         String
  provider          String               @default("resend")
  method            String               @default("email")
  status            InvoiceDeliveryStatus @default(PENDING)
  attempts          Int                  @default(0)
  externalMessageId String?
  errorMessage      String?
  sentAt            DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model CreditNote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  invoiceId  String
  noteNumber String   @unique
  reason     String
  amount     Decimal  @db.Decimal(20, 6)
  metadata   Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Audit / Durable event logs ───────────────────────────────────────────────

model AuditEvent {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  teamId      String
  actorType   AuditActorType
  actorUserId String?
  actorAddress String?
  action      String
  resourceType String
  resourceId   String?
  requestId    String
  ip           String?
  userAgent    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, action])
  @@index([requestId])
}

model BillingEvent {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  teamId         String
  eventType      BillingEventType
  idempotencyKey String           @unique
  source         String           @default("facilitator")
  payload        Json
  processed      Boolean          @default(false)
  processedAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, processed])
}

model SubscriptionState {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  teamId            String
  companyId         String             @unique
  walletAddress     String?
  status            SubscriptionStatus @default(ACTIVE)
  catalogPlanId     String?
  onChainPlanId     String?
  onChainTokenId    String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastEvent         String?
  lastEventAt       DateTime?
  lastSourceTxHash  String?
  cancelAtPeriodEnd Boolean            @default(false)
  cancelledAt       DateTime?
  pastDueAt         DateTime?
  graceEndsAt       DateTime?
  metadata          Json?

  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company ArcenCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments Payment[]
  billingAdjustments BillingAdjustment[]

  @@index([teamId, status])
  @@index([teamId, walletAddress])
}

model Payment {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  teamId              String
  companyId           String?
  invoiceId           String?
  subscriptionStateId String?
  idempotencyKey      String        @unique
  kind                PaymentKind
  status              PaymentStatus @default(PENDING)
  currency            String        @default("USDC")
  amount              Decimal       @db.Decimal(20, 6)
  payerWallet         String?
  recipientWallet     String?
  acceptedToken       String?
  txHash              String?       @unique
  externalRef         String?
  occurredAt          DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  metadata            Json?

  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company           ArcenCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriptionState SubscriptionState? @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)
  attempts          PaymentAttempt[]
  billingAdjustments BillingAdjustment[]
  refunds           Refund[]

  @@index([teamId, status, occurredAt])
  @@index([companyId, createdAt])
  @@index([invoiceId])
  @@index([subscriptionStateId])
}

model PaymentAttempt {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  paymentId    String
  status       PaymentAttemptStatus
  txHash       String?
  errorCode    String?
  errorMessage String?
  attemptedAt  DateTime             @default(now())
  resolvedAt   DateTime?
  metadata     Json?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, attemptedAt])
  @@index([txHash])
}

model BillingAdjustment {
  id                  String                  @id @default(cuid())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  teamId              String
  companyId           String
  subscriptionStateId String?
  paymentId           String?
  kind                BillingAdjustmentKind
  status              BillingAdjustmentStatus @default(PENDING)
  currency            String                  @default("USDC")
  amount              Decimal                 @db.Decimal(20, 6)
  fromCatalogPlanId   String?
  toCatalogPlanId     String?
  periodStartedAt     DateTime?
  periodEndsAt        DateTime?
  effectiveAt         DateTime?
  postedAt            DateTime?
  voidedAt            DateTime?
  metadata            Json?

  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company           ArcenCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionState SubscriptionState? @relation(fields: [subscriptionStateId], references: [id], onDelete: SetNull)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refunds           Refund[]

  @@index([teamId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([subscriptionStateId, createdAt])
  @@index([paymentId])
}

model BillingBalance {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  teamId              String
  companyId           String   @unique
  currency            String   @default("USDC")
  availableCredit     Decimal  @default(0) @db.Decimal(20, 6)
  totalCredited       Decimal  @default(0) @db.Decimal(20, 6)
  totalDebited        Decimal  @default(0) @db.Decimal(20, 6)
  lastAppliedAt       DateTime?
  metadata            Json?

  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company ArcenCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([teamId, currency, updatedAt])
}

model Refund {
  id                  String       @id @default(cuid())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  teamId              String
  companyId           String?
  invoiceId           String?
  paymentId           String?
  billingAdjustmentId String?
  status              RefundStatus @default(PENDING)
  currency            String       @default("USDC")
  amount              Decimal      @db.Decimal(20, 6)
  reason              String
  txHash              String?      @unique
  externalRef         String?
  occurredAt          DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  metadata            Json?

  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company           ArcenCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  billingAdjustment BillingAdjustment? @relation(fields: [billingAdjustmentId], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([billingAdjustmentId])
}

model BillingRecoveryTask {
  id            String                   @id @default(cuid())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  teamId        String
  companyId     String?
  kind          BillingRecoveryTaskKind
  status        BillingRecoveryTaskStatus @default(PENDING)
  idempotencyKey String                  @unique
  txHash        String?                  @unique
  walletAddress String?
  payload       Json
  attempts      Int                      @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  completedAt   DateTime?
  lastError     String?

  team    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company ArcenCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([teamId, status, nextAttemptAt, createdAt])
  @@index([companyId, createdAt])
  @@index([walletAddress, createdAt])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  teamId        String
  deliveryId    String   @unique
  event         String
  url           String
  statusCode    Int?
  attemptNumber Int
  deliveredAt   DateTime
  success       Boolean
  error         String?
  payload       Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, deliveredAt])
  @@index([teamId, success])
}

// ─── Platform Tier Configuration ──────────────────────────────────────────────

model PlatformTierConfig {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tier            PlatformTier @unique

  maxWorkspaces     Int     @default(1)
  maxPlans          Int     @default(1)
  maxSubscribers    Int     @default(100)
  maxTeamMembers    Int     @default(1)
  maxFeatureFlags   Int     @default(3)
  maxChains         Int     @default(1)
  platformFeeBps    Int     @default(200)      // 2.0% for Free
  gasSponsored      Boolean @default(true)
  gasDailyBudgetUsd Decimal @default(0.50) @db.Decimal(10, 2)
}

// ─── Gas Sponsorship Tracking ─────────────────────────────────────────────────

model GasSpend {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  teamId        String
  chainId       Int
  txHash        String   @unique
  gasUsedWei    String
  gasCostUsd    Decimal  @db.Decimal(20, 8)
  walletAddress String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, walletAddress, createdAt])
}

// ─── Tier Upgrade History ─────────────────────────────────────────────────

model TierUpgradeHistory {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  teamId    String
  fromTier  PlatformTier
  toTier    PlatformTier
  txHash    String?
  amountUsd Decimal?     @db.Decimal(10, 2)
  userId    String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

// ─── Pro Support Tickets ──────────────────────────────────────────────────

model SupportTicket {
  id         String                @id @default(cuid())
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  teamId     String
  userId     String
  subject    String
  body       String
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(NORMAL)
  category   String?
  assignee   String?
  resolvedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([teamId, createdAt])
  @@index([status, priority])
}

// ─── Web3 ArcenPay Protocol Layer ─────────────────────────────────────────────
// Companies, Users, Events, Feature Flags, Rules, Overrides, Access Tokens,
// API Keys, zkTLS Proofs, Embeddable Components

model ArcenCompany {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
  teamId        String

  name          String
  walletAddress String?  // Primary Web3 identity
  email         String?
  externalId    String?  // Caller's own internal UUID/ID
  logoUrl       String?
  traits        Json     @default("{}")

  // Active plan assignment (references CatalogPlan.id)
  activePlanId  String?
  // Active add-on IDs (JSON array of CatalogAddOn.id)
  activeAddOnIds Json    @default("[]")

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  users     ArcenUser[]
  overrides CompanyOverride[]
  events    ArcenEvent[]
  zkProofs  ZkTlsProof[]
  subscriptionState SubscriptionState?
  billingBalance BillingBalance?
  payments  Payment[]
  refunds   Refund[]
  billingAdjustments BillingAdjustment[]
  billingRecoveryTasks BillingRecoveryTask[]

  @@unique([teamId, walletAddress])
  @@unique([teamId, externalId])
  @@index([teamId, email])
  @@index([teamId, lastSeenAt])
  @@map("SchematicCompany")
}

model ArcenUser {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
  teamId        String

  companyId     String
  name          String?
  email         String?
  walletAddress String?
  clerkUserId   String?
  externalId    String?
  traits        Json     @default("{}")

  company ArcenCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zkProofs ZkTlsProof[]

  @@unique([teamId, walletAddress])
  @@unique([teamId, clerkUserId])
  @@index([teamId, companyId])
  @@index([teamId, externalId])
  @@index([teamId, email])
  @@map("SchematicUser")
}

model ArcenEvent {
  id        String   @id @default(cuid())
  sentAt    DateTime @default(now())
  teamId    String

  eventType String   // "track" | "identify" | "flag_check"
  name      String?  // event key for track events (e.g., "scan")
  companyId String?
  userId    String?
  traits    Json     @default("{}")

  company ArcenCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([teamId, name, companyId, sentAt])
  @@index([teamId, eventType, sentAt])
  @@index([teamId, companyId, sentAt])
  @@map("SchematicEvent")
}

model CatalogFeatureFlag {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teamId       String

  featureKey   String   // unique key used in API calls (e.g., "scan")
  name         String
  description  String?
  defaultValue Boolean  @default(false)

  // Feature type: boolean | event_based | trait_based
  featureType  String   @default("boolean")

  // For event_based features
  eventKey         String?  // e.g., "scan" — matches ArcenEvent.name
  unitSingular     String?  // e.g., "Scan"
  unitPlural       String?  // e.g., "Scans"

  rules FlagRule[]
  team  Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, featureKey])
  @@index([teamId])
}

model FlagRule {
  id       String  @id @default(cuid())
  flagId   String
  priority Int     // evaluation order — lower number = evaluated first
  value    Boolean // True or False to serve when this rule matches

  // 'manual' (default) | 'plan' — tracks auto-generated rules
  source   String? @default("manual")
  // For source='plan': the CatalogPlan.id that generated this rule
  sourceId String?

  conditions FlagRuleCondition[]
  flag       CatalogFeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, priority])
  @@index([flagId, source, sourceId])
}

model FlagRuleCondition {
  id           String  @id @default(cuid())
  ruleId       String

  // criteriaType: base_plan | add_on | usage | company_trait | user_trait | zktls_claim
  criteriaType String
  // operator: is_one_of | is_less_than | is_greater_than | equals | contains | not_equals
  operator     String
  // JSON array of plan/add-on IDs or string values for is_one_of
  values       Json    @default("[]")

  // For usage criteria
  metricKey    String? // matches ArcenEvent.name (e.g., "scan")
  metricValue  Float?  // threshold (e.g., 300)
  metricPeriod String? // "monthly" | "daily" | "weekly"

  // For company_trait / user_trait criteria
  traitKey     String?

  // For zktls_claim criteria
  zktlsProviderId String? // Reclaim Protocol provider ID

  rule FlagRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model CompanyOverride {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamId     String

  companyId  String
  featureKey String
  value      Boolean
  reason     String?

  company ArcenCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey])
  @@index([teamId, companyId])
}

// Short-lived tokens for embeddable component authentication
model EmbedAccessToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  teamId    String

  tokenHash  String   @unique
  companyId  String?
  userId     String?
  expiresAt  DateTime

  @@index([teamId])
  @@index([expiresAt])
}

// External API keys for ArcenPay developer access
model ArcenApiKey {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  teamId      String

  name        String
  keyHash     String    @unique  // argon2 hash of the actual key
  prefix      String             // first 12 chars for display (e.g., api_abc12345..)
  description String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("SchematicApiKey")
}

// zkTLS proofs submitted via Reclaim Protocol
model ZkTlsProof {
  id            String   @id @default(cuid())
  verifiedAt    DateTime @default(now())
  teamId        String

  companyId     String?
  userId        String?
  providerId    String   // Reclaim Protocol provider ID
  providerName  String   // human-readable (e.g., "Stripe Subscription Status")
  claimData     Json     // verified structured claims extracted from proof
  proofHash     String   @unique  // prevents replay attacks
  expiresAt     DateTime?

  company ArcenCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    ArcenUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, companyId])
  @@index([teamId, providerId])
  @@index([expiresAt])
}

// Embeddable UI components
model EmbedComponent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamId    String

  name     String
  // JSON array of element configs (planManager, meteredFeatures, plansTable, etc.)
  elements Json    @default("[]")
  // Design settings: colors, typography, layout
  design   Json    @default("{}")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
