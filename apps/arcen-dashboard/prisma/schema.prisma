// ArcenPay Dashboard — Prisma Schema
// Core entities:
//   User / Team / TeamMember / ProviderProfile
// Added production domains:
//   Catalog, Templates, Invoices, Audit, Billing/Webhook durability

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TeamRole {
  OWNER
  ADMIN
  FINANCE
  DEVELOPER
  SUPPORT
  MEMBER
}

enum EnvironmentMode {
  DEVELOPMENT
  PRODUCTION
}

enum CatalogEntityType {
  PLAN
  ADDON
  CREDIT
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChainSyncStatus {
  PENDING
  SYNCED
  FAILED
  NOT_APPLICABLE
}

enum AddOnBillingType {
  ONE_TIME
  RECURRING
}

enum TemplateInstallStatus {
  INSTALLED
  UNINSTALLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum InvoiceDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum BillingEventType {
  SUBSCRIPTION_MINTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  PAYMENT_FAILED
  CREDIT_ISSUED
}

enum AuditActorType {
  USER
  API
  SYSTEM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PlatformTier {
  FREE
  PLUS
  PRO
}

// ─── Core identity ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email         String? @unique
  emailVerified Boolean @default(false)
  walletAddress String? @unique
  clerkUserId   String? @unique

  currentTeamId String?

  magicTokens MagicToken[]
  teams       TeamMember[]

  @@index([email])
  @@index([walletAddress])
  @@index([clerkUserId])
}

// ─── Passwordless email login ─────────────────────────────────────────────────

model MagicToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
}

// ─── Teams / Workspaces ───────────────────────────────────────────────────────

model Team {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  name            String
  slug            String          @unique
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  invoicePrefix   String?
  clerkOrgId      String?         @unique

  // Platform tier (ArcenPay's own billing tier for this workspace)
  platformTier       PlatformTier @default(FREE)
  tierExpiresAt      DateTime?
  tierSubscriptionId String?      // On-chain subscription tokenId for self-billing

  members         TeamMember[]
  providerProfile ProviderProfile?

  catalogPlans       CatalogPlan[]
  catalogAddOns      CatalogAddOn[]
  catalogCreditTypes CatalogCreditType[]
  catalogVersions    CatalogVersion[]
  catalogConfigs     CatalogConfig[]

  billingTemplates BillingTemplate[]
  templateInstalls TemplateInstall[]

  invoices         Invoice[]
  taxProfile       TaxProfile?
  invoiceSequences InvoiceSequence[]

  auditEvents        AuditEvent[]
  billingEvents      BillingEvent[]
  webhookDeliveries  WebhookDelivery[]
  gasSpends          GasSpend[]
  tierHistory        TierUpgradeHistory[]
  supportTickets     SupportTicket[]

  @@index([slug])
  @@index([clerkOrgId])
  @@index([platformTier])
}

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  role   TeamRole @default(MEMBER)
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model ProviderProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerName  String?
  website       String?
  contactEmail  String?

  notifyEmail         Boolean @default(true)
  notifyWebhook       Boolean @default(false)
  webhookUrl          String?
  webhookSigningSecret String?

  // Per-event notification preferences stored as JSON array of
  // { id: string, email: boolean, webhook: boolean }
  notificationPreferences Json?

  apiKeyHash   String? @unique
  apiKeyPrefix String?

  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ─── Subscriber email registry ────────────────────────────────────────────────

model SubscriberEmail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletAddress String @unique
  email         String
  planId        String?

  @@index([walletAddress])
  @@index([email])
}

// ─── Auth nonce store ─────────────────────────────────────────────────────────

model AuthNonce {
  nonce     String   @id
  issuedAt  String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

// ─── Catalog (Plans / Add-ons / Credits) ─────────────────────────────────────

model CatalogPlan {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name           String
  tier           String
  description    String?
  price          Decimal          @db.Decimal(20, 6)
  billingInterval Int
  acceptedToken  String
  metadata       Json?

  active      Boolean   @default(true)
  version     Int       @default(1)
  publishedAt DateTime?

  onChainPlanId   String?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, environmentMode, status])
  @@index([teamId, name])
}

model CatalogAddOn {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name        String
  code        String
  description String?
  billingType AddOnBillingType @default(ONE_TIME)
  price       Decimal          @db.Decimal(20, 6)
  acceptedToken String
  metadata    Json?

  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
}

model CatalogCreditType {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          CatalogStatus   @default(DRAFT)

  name         String
  code         String
  unitName     String
  unitsPerPack Int
  price        Decimal @db.Decimal(20, 6)
  acceptedToken String

  active          Boolean         @default(true)
  version         Int             @default(1)
  publishedAt     DateTime?
  chainSyncStatus ChainSyncStatus @default(NOT_APPLICABLE)
  chainTxHash     String?
  chainSyncError  String?
  chainSyncedAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, code, environmentMode])
  @@index([teamId, environmentMode, status])
}

model CatalogVersion {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  publishedAt     DateTime?
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  entityType      CatalogEntityType
  entityId        String
  version         Int
  status          CatalogStatus   @default(DRAFT)
  snapshot        Json

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, entityType, entityId, version])
  @@index([teamId, environmentMode, status])
}

model CatalogConfig {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)

  initialPlan                 String  @default("Free")
  fallbackPlan                String?
  showBillingPeriodToggle     Boolean @default(true)
  freePlanPriceDisplay        Boolean @default(true)
  hideCredits                 Boolean @default(false)
  yearlyDiscountDisplay       Boolean @default(true)
  showFeatureDescriptions     Boolean @default(true)
  showHardLimits              Boolean @default(true)
  upgradeImmediately          Boolean @default(true)
  downgradeImmediately        Boolean @default(false)
  preventDowngradeOverLimit   Boolean @default(true)
  disallowSelfServiceDowngrade Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, environmentMode])
  @@index([teamId, environmentMode])
}

// ─── Template Library ─────────────────────────────────────────────────────────

model BillingTemplate {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teamId        String
  name          String
  slug          String
  description   String?
  status        CatalogStatus @default(DRAFT)
  currentVersion Int          @default(1)

  team     Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions BillingTemplateVersion[]
  installs TemplateInstall[]

  @@unique([teamId, slug])
  @@index([teamId, status])
}

model BillingTemplateVersion {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  templateId    String
  version       Int
  schemaJson    Json
  reactBlocks   Json
  styleTokens   Json
  compatibility Json

  template BillingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
}

model TemplateInstall {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  teamId          String
  templateId      String
  installedVersion Int
  environmentMode EnvironmentMode     @default(DEVELOPMENT)
  chainId         Int
  status          TemplateInstallStatus @default(INSTALLED)

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template BillingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([teamId, environmentMode, status])
  @@unique([teamId, templateId, environmentMode, chainId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model TaxProfile {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teamId       String   @unique
  legalName    String
  country      String
  taxId        String?
  gstin        String?
  addressJson  Json
  taxRegime    String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamId     String
  year       Int
  lastNumber Int      @default(0)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, year])
  @@index([teamId])
}

model Invoice {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  teamId          String
  environmentMode EnvironmentMode @default(DEVELOPMENT)
  status          InvoiceStatus   @default(DRAFT)

  number         String? @unique
  currency       String  @default("USDC")
  customerEmail  String?
  customerWallet String?

  subtotal Decimal @default(0) @db.Decimal(20, 6)
  taxTotal  Decimal @default(0) @db.Decimal(20, 6)
  total     Decimal @default(0) @db.Decimal(20, 6)

  dueAt      DateTime?
  issuedAt   DateTime?
  paidAt     DateTime?
  externalRef String?
  planId      String?
  metadata    Json?

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lineItems  InvoiceLine[]
  deliveries InvoiceDelivery[]
  creditNotes CreditNote[]

  @@index([teamId, status, issuedAt])
  @@index([teamId, environmentMode])
}

model InvoiceLine {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  invoiceId  String
  description String
  quantity   Int      @default(1)

  unitAmount Decimal @db.Decimal(20, 6)
  taxRate    Decimal @default(0) @db.Decimal(8, 4)
  lineSubtotal Decimal @db.Decimal(20, 6)
  lineTax      Decimal @default(0) @db.Decimal(20, 6)
  lineTotal    Decimal @db.Decimal(20, 6)

  metadata Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceDelivery {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  invoiceId         String
  provider          String               @default("resend")
  method            String               @default("email")
  status            InvoiceDeliveryStatus @default(PENDING)
  attempts          Int                  @default(0)
  externalMessageId String?
  errorMessage      String?
  sentAt            DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

model CreditNote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  invoiceId  String
  noteNumber String   @unique
  reason     String
  amount     Decimal  @db.Decimal(20, 6)
  metadata   Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Audit / Durable event logs ───────────────────────────────────────────────

model AuditEvent {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  teamId      String
  actorType   AuditActorType
  actorUserId String?
  actorAddress String?
  action      String
  resourceType String
  resourceId   String?
  requestId    String
  ip           String?
  userAgent    String?
  beforeData   Json?
  afterData    Json?
  metadata     Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, action])
  @@index([requestId])
}

model BillingEvent {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  teamId         String
  eventType      BillingEventType
  idempotencyKey String           @unique
  source         String           @default("facilitator")
  payload        Json
  processed      Boolean          @default(false)
  processedAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, processed])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  teamId        String
  deliveryId    String   @unique
  event         String
  url           String
  statusCode    Int?
  attemptNumber Int
  deliveredAt   DateTime
  success       Boolean
  error         String?
  payload       Json?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, deliveredAt])
  @@index([teamId, success])
}

// ─── Platform Tier Configuration ──────────────────────────────────────────────

model PlatformTierConfig {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tier            PlatformTier @unique

  maxWorkspaces     Int     @default(1)
  maxPlans          Int     @default(1)
  maxSubscribers    Int     @default(100)
  maxTeamMembers    Int     @default(1)
  maxFeatureFlags   Int     @default(3)
  maxChains         Int     @default(1)
  platformFeeBps    Int     @default(200)      // 2.0% for Free
  gasSponsored      Boolean @default(true)
  gasDailyBudgetUsd Decimal @default(0.50) @db.Decimal(10, 2)
}

// ─── Gas Sponsorship Tracking ─────────────────────────────────────────────────

model GasSpend {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  teamId        String
  chainId       Int
  txHash        String   @unique
  gasUsedWei    String
  gasCostUsd    Decimal  @db.Decimal(20, 8)
  walletAddress String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, walletAddress, createdAt])
}

// ─── Tier Upgrade History ─────────────────────────────────────────────────

model TierUpgradeHistory {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  teamId    String
  fromTier  PlatformTier
  toTier    PlatformTier
  txHash    String?
  amountUsd Decimal?     @db.Decimal(10, 2)
  userId    String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

// ─── Pro Support Tickets ──────────────────────────────────────────────────

model SupportTicket {
  id         String                @id @default(cuid())
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  teamId     String
  userId     String
  subject    String
  body       String
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(NORMAL)
  category   String?
  assignee   String?
  resolvedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([teamId, createdAt])
  @@index([status, priority])
}
