{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arcenpay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "minify": true,
  "limits": {
    "cpu_ms": 30000
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
