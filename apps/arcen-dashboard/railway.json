{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@arcenpay/dashboard"
  },
  "deploy": {
    "startCommand": "npx next start apps/arcen-dashboard --hostname 0.0.0.0 --port $PORT",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
