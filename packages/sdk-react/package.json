{
  "name": "@arcenpay/react",
  "version": "0.0.1",
  "description": "ArcenPay SDK — React components for Web3 subscription billing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve --sourcemap --external react --external @zerodev/sdk --external @zerodev/ecdsa-validator",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --external @zerodev/sdk --external @zerodev/ecdsa-validator --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@zerodev/sdk": "^5.0.0",
    "@zerodev/ecdsa-validator": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@zerodev/sdk": {
      "optional": true
    },
    "@zerodev/ecdsa-validator": {
      "optional": true
    }
  },
  "dependencies": {
    "@arcenpay/sdk": "*",
    "@tanstack/react-query": "^5.62.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.7",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
