{
  "name": "@arcenpay/react",
  "version": "0.0.3",
  "description": "ArcenPay SDK — React components for Web3 subscription billing",
  "license": "MIT",
  "homepage": "https://app.arcenpay.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arcenpay/Arcenpay.git"
  },
  "bugs": {
    "url": "https://github.com/Arcenpay/Arcenpay/issues"
  },
  "keywords": [
    "arcenpay",
    "react",
    "web3",
    "subscriptions",
    "billing",
    "wagmi"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./smart-account": {
      "types": "./dist/smart-account.d.ts",
      "import": "./dist/smart-account.mjs",
      "require": "./dist/smart-account.js",
      "default": "./dist/smart-account.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:core": "node ../../scripts/sync-internal-core.mjs sdk-react",
    "prebuild": "npm run sync:core",
    "predev": "npm run sync:core",
    "pretest": "npm run sync:core",
    "pretypecheck": "npm run sync:core",
    "build": "npx tsup src/index.ts src/smart-account.ts --clean --format cjs,esm --dts --dts-resolve --external react --external permissionless",
    "dev": "npx tsup src/index.ts src/smart-account.ts --clean --format cjs,esm --dts --external react --external permissionless --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.454.0",
    "permissionless": "^0.3.5",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
