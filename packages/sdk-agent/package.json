{
  "name": "@arcenpay/agent",
  "version": "1.1.0",
  "description": "ArcenPay SDK \u2014 AI agent client for autonomous x402 payments",
  "license": "MIT",
  "homepage": "https://app.arcenpay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcenpay/Arcenpay.git"
  },
  "bugs": {
    "url": "https://github.com/Arcenpay/Arcenpay/issues"
  },
  "keywords": [
    "arcenpay",
    "agent",
    "ai",
    "web3",
    "x402",
    "payments"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:core": "node ../../scripts/sync-internal-core.mjs sdk-agent",
    "prebuild": "npm run sync:core",
    "predev": "npm run sync:core",
    "pretest": "npm run sync:core",
    "pretypecheck": "npm run sync:core",
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve --sourcemap",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  }
}
