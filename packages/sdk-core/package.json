{
  "name": "@arcenpay/sdk",
  "version": "0.0.1",
  "description": "ArcenPay SDK — Shared types, ABIs, and chain configs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve --sourcemap",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@zerodev/sdk": ">=5.0.0",
    "@zerodev/ecdsa-validator": ">=5.0.0",
    "permissionless": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@zerodev/sdk": {
      "optional": true
    },
    "@zerodev/ecdsa-validator": {
      "optional": true
    },
    "permissionless": {
      "optional": true
    }
  }
}
