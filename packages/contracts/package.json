{
  "name": "@arcenpay/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "ArcenPay + ZKVUB Protocol Smart Contracts",
  "scripts": {
    "build": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile",
    "test": "npm run test:forge:auto",
    "test:forge:auto": "sh -c 'if docker info >/dev/null 2>&1; then npm run test:forge:docker; else echo \"[contracts] docker unavailable; falling back to local forge --offline\"; npm run test:forge:local; fi'",
    "test:forge:local": "forge test --offline -vvv",
    "test:forge:docker": "docker run --rm -v $(pwd)/../..:/repo -w /repo/packages/contracts ghcr.io/foundry-rs/foundry:stable \"forge test -vvv\"",
    "forge:build:docker": "docker run --rm -v $(pwd)/../..:/repo -w /repo/packages/contracts ghcr.io/foundry-rs/foundry:stable \"forge build --sizes\"",
    "forge:coverage:docker": "docker run --rm -v $(pwd)/../..:/repo -w /repo/packages/contracts ghcr.io/foundry-rs/foundry:stable \"forge coverage --report summary\"",
    "forge:snapshot:docker": "docker run --rm -v $(pwd)/../..:/repo -w /repo/packages/contracts ghcr.io/foundry-rs/foundry:stable \"forge snapshot --check\"",
    "test:hardhat": "hardhat test",
    "clean": "hardhat clean && forge clean",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:base-mainnet": "hardhat run scripts/deploy.ts --network baseMainnet",
    "deploy:arc-testnet": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:bot-testnet": "hardhat run scripts/deploy.ts --network botTestnet",
    "deploy:bot-mainnet": "hardhat run scripts/deploy.ts --network botMainnet",
    "upgrade:sepolia": "hardhat run scripts/upgrade.ts --network sepolia",
    "upgrade:base-sepolia": "hardhat run scripts/upgrade.ts --network baseSepolia",
    "upgrade:base-mainnet": "hardhat run scripts/upgrade.ts --network baseMainnet",
    "upgrade:arc-testnet": "hardhat run scripts/upgrade.ts --network arcTestnet",
    "upgrade:bot-testnet": "hardhat run scripts/upgrade.ts --network botTestnet",
    "upgrade:bot-mainnet": "hardhat run scripts/upgrade.ts --network botMainnet",
    "ops:snapshot-live-state:sepolia": "hardhat run scripts/snapshot-live-state.ts --network sepolia",
    "ops:snapshot-live-state:base-sepolia": "hardhat run scripts/snapshot-live-state.ts --network baseSepolia",
    "ops:snapshot-live-state:base-mainnet": "hardhat run scripts/snapshot-live-state.ts --network baseMainnet",
    "ops:import-live-state:sepolia": "hardhat run scripts/import-live-state.ts --network sepolia",
    "ops:import-live-state:base-sepolia": "hardhat run scripts/import-live-state.ts --network baseSepolia",
    "ops:import-live-state:base-mainnet": "hardhat run scripts/import-live-state.ts --network baseMainnet",
    "deploy:mock-usdc:sepolia": "hardhat run scripts/deploy-mock-usdc.ts --network sepolia",
    "deploy:mock-usdc:base-sepolia": "hardhat run scripts/deploy-mock-usdc.ts --network baseSepolia",
    "deploy:mock-usdc:arc-testnet": "hardhat run scripts/deploy-mock-usdc.ts --network arcTestnet",
    "deploy:export-manifest": "hardhat run scripts/export-environment-manifest.ts --network hardhat",
    "smoke:sepolia": "hardhat run scripts/smoke.ts --network sepolia",
    "smoke:base-sepolia": "hardhat run scripts/smoke.ts --network baseSepolia",
    "smoke:base-mainnet": "hardhat run scripts/smoke.ts --network baseMainnet",
    "smoke:arc-testnet": "hardhat run scripts/smoke.ts --network arcTestnet",
    "smoke:bot-testnet": "hardhat run scripts/smoke.ts --network botTestnet",
    "smoke:bot-mainnet": "hardhat run scripts/smoke.ts --network botMainnet",
    "ops:authorize-facilitator:settler": "hardhat run scripts/authorize-facilitator-settler.ts --network sepolia",
    "ops:set-groth16-verifier": "hardhat run scripts/set-groth16-verifier.ts --network sepolia",
    "ops:plan-factory-owner": "hardhat run scripts/ops-plan-factory-owner.ts --network sepolia",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/hardhat-viem": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.0",
    "typechain": "^8.3.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
