{
  "name": "@meap/node",
  "version": "0.0.1",
  "description": "MEAP Protocol — Node.js Facilitator SDK with x402 middleware",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./tableland": {
      "types": "./dist/tableland.d.ts",
      "import": "./dist/tableland.mjs",
      "require": "./dist/tableland.js",
      "default": "./dist/tableland.mjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/tableland.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/tableland.ts --format cjs,esm --dts --watch",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lit-protocol/constants": "^7.4.0",
    "@lit-protocol/encryption": "^7.4.0",
    "@lit-protocol/lit-node-client": "^7.4.0",
    "@tableland/sdk": "^7.2.1",
    "@meap/core": "*",
    "ethers": "^6.13.5",
    "redis": "^4.7.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  }
}
