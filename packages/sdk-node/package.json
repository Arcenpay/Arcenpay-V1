{
  "name": "@arcenpay/node",
  "version": "0.0.2",
  "description": "ArcenPay SDK — Node.js middleware and billing services",
  "license": "UNLICENSED",
  "homepage": "https://app.arcenpay.com",
  "keywords": [
    "arcenpay",
    "web3",
    "subscriptions",
    "billing",
    "node",
    "x402"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "import": "./dist/client-entry.mjs",
      "require": "./dist/client-entry.js",
      "default": "./dist/client-entry.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "default": "./dist/core.mjs"
    },
    "./event-contracts": {
      "types": "./dist/event-contracts.d.ts",
      "import": "./dist/event-contracts.mjs",
      "require": "./dist/event-contracts.js",
      "default": "./dist/event-contracts.mjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.mjs",
      "require": "./dist/webhooks.js",
      "default": "./dist/webhooks.mjs"
    },
    "./tableland": {
      "types": "./dist/tableland.d.ts",
      "import": "./dist/tableland.mjs",
      "require": "./dist/tableland.js",
      "default": "./dist/tableland.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:core": "node ../../scripts/sync-internal-core.mjs sdk-node",
    "prebuild": "npm run sync:core",
    "predev": "npm run sync:core",
    "pretest": "npm run sync:core",
    "pretypecheck": "npm run sync:core",
    "build": "tsup src/index.ts src/client-entry.ts src/core.ts src/event-contracts.ts src/webhooks.ts src/tableland.ts --clean --format cjs,esm --dts --dts-resolve",
    "dev": "tsup src/index.ts src/client-entry.ts src/core.ts src/event-contracts.ts src/webhooks.ts src/tableland.ts --clean --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lit-protocol/constants": "^7.4.0",
    "@lit-protocol/encryption": "^7.4.0",
    "@lit-protocol/lit-node-client": "^7.4.0",
    "@tableland/sdk": "^7.2.1",
    "ethers": "^6.13.5",
    "redis": "^4.7.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
