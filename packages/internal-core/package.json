{
  "name": "@arcenpay/internal-core",
  "version": "1.0.0",
  "private": true,
  "description": "Private shared runtime for ArcenPay internal services",
  "license": "UNLICENSED",
  "homepage": "https://app.arcenpay.com",
  "keywords": [
    "arcenpay",
    "web3",
    "subscriptions",
    "billing",
    "base",
    "internal"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format cjs,esm --dts --dts-resolve",
    "dev": "npx tsup src/index.ts --clean --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "permissionless": "^0.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  }
}
