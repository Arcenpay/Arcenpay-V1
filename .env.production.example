# ==============================================================================
#  ArcenPay — Production Environment Configuration Template
# ==============================================================================
#  This file provides the complete environment variable specification for:
#    1. Railway Service: apps/arcen-backend (REST API / Hono)
#    2. Railway Service: apps/facilitator (Bridge / Express)
#    3. Vercel Project:  apps/arcen-dashboard (Next.js 16 App Router)
# ==============================================================================

# ==============================================================================
# 1. RAILWAY SERVICE: BACKEND API (apps/arcen-backend)
# ==============================================================================
NODE_ENV=production
# PORT is automatically injected by Railway (defaults to 3300 if unset)
# PORT=3300

# --- Database & Storage ---
# Live production PostgreSQL connection string (e.g. Aiven, Railway Postgres, Neon)
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_HOST:15022/defaultdb?sslmode=require

# --- Authentication & Session Security ---
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_with_strong_64char_hex_secret
SIWE_JWT_SECRET=replace_with_strong_64char_hex_secret

# --- Bridge Communication Secret ---
# Shared between Backend and Facilitator to authenticate internal calls & billing events
FACILITATOR_SECRET=replace_with_strong_shared_facilitator_secret
FACILITATOR_URL=https://YOUR_FACILITATOR_RAILWAY_URL.up.railway.app

# --- Web & Cross-Origin ---
DASHBOARD_URL=https://app.arcenpay.com
APP_URL=https://app.arcenpay.com
CORS_ORIGINS=https://app.arcenpay.com,https://arcenpay.com

# --- Security & Rate Limiting (Arcjet) ---
ARCJET_KEY=ajkey_YOUR_ARCJET_KEY

# --- Monitoring (Sentry) ---
SENTRY_DSN=https://YOUR_SENTRY_KEY@ingest.sentry.io/YOUR_PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_KEY@ingest.sentry.io/YOUR_PROJECT_ID

# --- Platform Governance & Admin ---
PLATFORM_REQUIRE_ACTIVATION_KEY=true
PLATFORM_ADMIN_EMAILS=aditya@arcenpay.com,admin@arcenpay.com
PLATFORM_OWNER_EMAIL=aditya@arcenpay.com
PLATFORM_ADMIN_SECRET=replace_with_strong_admin_secret
ARCENPAY_ENABLE_PRODUCTION_ENVIRONMENTS=true
ARCENPAY_ENABLE_SELF_SERVE_PLAN_CHANGES=true
ARCENPAY_ENABLE_SELF_SERVE_CANCELLATION=true
ARCENPAY_REQUIRE_SUBGRAPH=false

# --- Email (Resend) ---
RESEND_API_KEY=re_YOUR_RESEND_KEY
EMAIL_FROM=noreply@arcenpay.com

# --- Invoices ---
INVOICE_STORAGE_DIR=/tmp/arcenpay/invoices
INVOICE_DOWNLOAD_SIGNING_SECRET=replace_with_strong_hmac_secret
INVOICE_DOWNLOAD_URL_TTL_SECONDS=86400

# --- Default Chain Configuration ---
CHAIN_ID=677
NEXT_PUBLIC_CHAIN_ID=677
MEAP_DEFAULT_CHAIN_ID=677

# --- BOT Chain Mainnet (Chain ID 677) RPC & Contracts ---
RPC_URL_677=https://rpc.botchain.ai
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
ARCENPAY_CONTRACT_677_planFactory=0x09fD8422638F4d6eA05F6Dcb2FB15Bea6eC59f41
ARCENPAY_CONTRACT_677_feeCollector=0x17375ec258cDABEB491AB9ae3F78428BC26Aa382
ARCENPAY_CONTRACT_677_subscriptionRegistry=0xea549C49A1A97faC398F977BCC0D65256c5419d9
ARCENPAY_CONTRACT_677_sessionVault=0x118C32C629F47109CF21a306A72c447127084CF4
ARCENPAY_CONTRACT_677_zkUsageVerifier=0x0694CB91b9399869ecB5942EF40AbD6C835Ba83a
ARCENPAY_CONTRACT_677_autopayModule=0xB240841d1c886455aC0620bB0A0AE1C194f3e275
ARCENPAY_CONTRACT_677_mirrorRegistry=0xE8E068FC93E9687c7D85d303312Ac13806e73e2F


# ==============================================================================
# 2. RAILWAY SERVICE: FACILITATOR BRIDGE (apps/facilitator)
# ==============================================================================
# NODE_ENV=production
# PORT is automatically injected by Railway (defaults to 3402 if unset)
# PORT=3402

# --- Backend Connectivity ---
# Public or internal Railway URL of the Backend service
BACKEND_URL=https://YOUR_BACKEND_RAILWAY_URL.up.railway.app
# Shared secret matching Backend's FACILITATOR_SECRET
# FACILITATOR_SECRET=replace_with_strong_shared_facilitator_secret

# --- Job Queue & State Cache ---
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379

# --- Keeper & Settlement Signer ---
# Signer wallet private key on BOT Chain Mainnet (must hold BOT for gas)
SUBSCRIPTION_BILLER_PRIVATE_KEY=YOUR_DEPLOYER_OR_BILLER_PRIVATE_KEY
ONCHAIN_PROVIDER_PRIVATE_KEY=YOUR_DEPLOYER_OR_BILLER_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_OR_BILLER_PRIVATE_KEY

# --- Facilitator Network Binding ---
CHAIN_ID=677
MEAP_DEFAULT_CHAIN_ID=677
# Note: Provide an eth_getLogs-capable RPC endpoint for BOT Chain event polling
MEAP_RPC_URL_677=https://rpc.botchain.ai
RPC_URL_677=https://rpc.botchain.ai

# --- Webhook Signing ---
WEBHOOK_SIGNING_SECRET=whsec_replace_with_svix_secret


# ==============================================================================
# 3. VERCEL PROJECT: DASHBOARD (apps/arcen-dashboard)
# ==============================================================================
# NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.arcenpay.com
APP_URL=https://app.arcenpay.com

# --- Backend API URL (Proxied via /api/*) ---
BACKEND_URL=https://YOUR_BACKEND_RAILWAY_URL.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://YOUR_BACKEND_RAILWAY_URL.up.railway.app

# --- Chain Settings ---
NEXT_PUBLIC_CHAIN_ID=677
MEAP_DEFAULT_CHAIN_ID=677

# --- Wallet Connection (Reown / WalletConnect) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=30ddbafd25c66a057fb4fc4f0c50b8c7

# --- Platform Administration ---
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=aditya@arcenpay.com,admin@arcenpay.com
NEXT_PUBLIC_PLATFORM_REQUIRE_ACTIVATION_KEY=true

# --- Feature Flags ---
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_PLAN_CHANGES=true
NEXT_PUBLIC_ARCENPAY_ENABLE_PORTAL_CANCELLATION=true
NEXT_PUBLIC_ARCENPAY_REQUIRE_SUBGRAPH=false
