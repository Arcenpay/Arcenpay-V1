{
  "name": "arcenpay",
  "version": "0.0.1",
  "private": true,
  "description": "Web3 Entitlement Layer — MEAP + ZKVUB Protocol",
  "workspaces": [
    "packages/*",
    "apps/*",
    "subgraph"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:sdk": "turbo run build --filter=@arcenpay/react --filter=@arcenpay/node --filter=@arcenpay/agent",
    "build:launch": "turbo run build --filter=@arcenpay/dashboard... --filter=@arcenpay/facilitator...",
    "dev": "turbo run dev --ui=tui",
    "dev:all": "turbo run dev --ui=tui",
    "dev:stream": "turbo run dev --ui=stream --log-order=stream --log-prefix=task",
    "dev:dashboard": "turbo run dev --ui=tui --filter=@arcenpay/dashboard...",
    "dev:docs": "turbo run dev --ui=tui --filter=@arcenpay/docs...",
    "dev:facilitator": "turbo run dev --ui=tui --filter=@arcenpay/facilitator...",
    "dev:backend": "turbo run dev --ui=tui --filter=@arcenpay/backend...",
    "build:backend": "turbo run build --filter=@arcenpay/backend...",
    "test": "turbo run test",
    "test:sdk": "turbo run test --filter=@arcenpay/react --filter=@arcenpay/node",
    "test:launch": "turbo run test --filter=@arcenpay/dashboard... --filter=@arcenpay/facilitator...",
    "typecheck": "turbo run typecheck",
    "typecheck:sdk": "turbo run typecheck --filter=@arcenpay/react --filter=@arcenpay/node",
    "typecheck:launch": "turbo run typecheck --filter=@arcenpay/dashboard... --filter=@arcenpay/facilitator...",
    "lint": "turbo run lint",
    "lint:launch": "turbo run lint --filter=@arcenpay/dashboard... --filter=@arcenpay/facilitator...",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "publish:sdk:dry-run": "npm run build:sdk && npm run test:sdk && npm run typecheck:sdk && npm publish --dry-run --workspace=@arcenpay/react --access public && npm publish --dry-run --workspace=@arcenpay/node --access public",
    "publish:sdk": "npm run build:sdk && npm run test:sdk && npm run typecheck:sdk && npm publish --workspace=@arcenpay/react --access public && npm publish --workspace=@arcenpay/node --access public",
    "tableland:create": "npx tsx scripts/create-tableland-table.ts",
    "verify:billing:baseline": "npx tsx scripts/verify-billing-hybrid.ts baseline",
    "verify:billing:env": "npx tsx scripts/verify-billing-hybrid.ts env",
    "verify:billing:live": "npx tsx scripts/verify-billing-hybrid.ts live",
    "verify:billing:all": "npx tsx scripts/verify-billing-hybrid.ts all",
    "setup:billing": "cd apps/arcen-backend && npm run setup:platform-billing"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "next": "^16.0.10",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "@arcjet/next": "^1.4.0",
    "@arcjet/node": "^1.4.0"
  }
}
